<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
    <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <section name="ntra_missions.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
    </sectionGroup>
  </configSections>
  <connectionStrings>
    <add name="ntra_missions.Properties.Settings.NTRAConnectionString" connectionString="Data Source=GIZA-ASAMEH\SQLEXPRESS;Initial Catalog=NTRA;User ID=sa;Password=NTRA@1234!" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <!-- Shared attachments folder. AttachmentsPath is tried first, then each entry
         of AttachmentsPathAlternates (semicolon separated), then the built-in
         fallbacks; the first location that is actually reachable wins.

         The IP address is first ON PURPOSE. The name "GIZA-ASAMEH" has both an A
         record (10.165.202.23) and an AAAA record for a link-local IPv6 address
         (fe80::...). Windows prefers IPv6, so a client on another subnet tries to
         reach the share over an address that cannot be routed there, the SMB
         connection fails, and Directory.Exists() simply answers "false" - which is
         why some users silently saw no attachments at all. Connecting by IP skips
         name resolution completely, and every client already reaches this host at
         that address for SQL Server.

         FQDN and short name follow as alternates, then the longer
         "Giza Software\Attachments" path, then Z: (a per-user drive mapping that
         only exists on machines where someone set it up). -->
    <add key="AttachmentsPath" value="\\10.165.202.23\Attachments" />
    <add key="AttachmentsPathAlternates" value="\\GIZA-ASAMEH.TRA.GOV.EG\Attachments;\\GIZA-ASAMEH\Attachments;\\10.165.202.23\Giza Software\Attachments;\\GIZA-ASAMEH\Giza Software\Attachments;Z:\Attachments" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <entityFramework>
    <defaultConnectionFactory type="System.Data.Entity.Infrastructure.SqlCeConnectionFactory, EntityFramework">
      <parameters>
        <parameter value="System.Data.SqlServerCe.4.0" />
      </parameters>
    </defaultConnectionFactory>
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
      <provider invariantName="System.Data.SqlServerCe.4.0" type="System.Data.Entity.SqlServerCompact.SqlCeProviderServices, EntityFramework.SqlServerCompact" />
    </providers>
  </entityFramework>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-6.0.0.0" newVersion="6.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Memory" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.1.2" newVersion="4.0.1.2" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
  <userSettings>
    <ntra_missions.Properties.Settings>
      <setting name="UserName" serializeAs="String">
        <value />
      </setting>
      <setting name="Password" serializeAs="String">
        <value />
      </setting>
    </ntra_missions.Properties.Settings>
  </userSettings>
</configuration>