<Page x:Class="ntra_missions.SignUpPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ntra_missions"
      mc:Ignorable="d" 
      Title="SignUpPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Column="0" Background="#000080" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
            <Image Source="Photos\NTRA_white1.png" Height="400" Width="500" />
        </Label>

        <ScrollViewer Grid.Column="1">
            <Grid  VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" VerticalAlignment="Center" Margin="12">
                    <Label Content="Username: " Width="135" Foreground="#000080" FontSize="22"/>
                    <TextBox Name="usernameTextBox" Style="{StaticResource textboxStyle}"/>
                </WrapPanel>

                <WrapPanel Grid.Row="1" VerticalAlignment="Center" Margin="12">
                    <Label Content="Name: " Width="135" Foreground="#000080" FontSize="22"/>
                    <TextBox Name="nameTextBox" Style="{StaticResource textboxStyle}"/>
                </WrapPanel>

                <WrapPanel Grid.Row="2" VerticalAlignment="Center" Margin="12">
                    <Label Content="Email: " Width="135" Foreground="#000080" FontSize="22"/>
                    <TextBox Name="emailTextBox" Style="{StaticResource textboxStyle}"/>
                </WrapPanel>

                <WrapPanel Grid.Row="3" VerticalAlignment="Center" Margin="12">
                    <Label Content="Telephone: " Width="135" Foreground="#000080" FontSize="22"/>
                    <TextBox Name="telephoneTextBox" Style="{StaticResource textboxStyle}" PreviewTextInput="NumberValidationTextBox"/>
                </WrapPanel>

                <WrapPanel Grid.Row="4" VerticalAlignment="Center" Margin="12">
                    <Label Content="Department: " Width="135" Foreground="#000080" FontSize="22"/>
                    <ComboBox Name="deprtmentComboBox" Style="{StaticResource comboBoxStyle}"/>
                </WrapPanel>

                <WrapPanel Grid.Row="5" VerticalAlignment="Center" Margin="12">
                    <Label Content="Password: " Width="135" Foreground="#000080" FontSize="22"/>
                    <PasswordBox Name="passwordTextBox" Style="{StaticResource passworsboxStyle}"/>
                </WrapPanel>

                <WrapPanel Grid.Row="6" VerticalAlignment="Center" Margin="12">
                    <Label Content="Confirm: " Width="135" Foreground="#000080" FontSize="22"/>
                    <PasswordBox Name="confirmPasswordTextBox" Style="{StaticResource passworsboxStyle}"/>
                </WrapPanel>

                <Button Grid.Row="7" Name="saveChangesButton" Click="OnBtnClickSaveChanges" Content="Save Changes" Style="{StaticResource buttonStyle}"/>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
