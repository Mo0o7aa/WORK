<Page x:Class="ntra_missions.EMFPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ntra_missions"
      mc:Ignorable="d" 
      Title="EMFPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="150"/>
            <RowDefinition Height="100"/>
            <RowDefinition/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#000080">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <WrapPanel>
                <Grid Name="mainMenuGrid" Background="LightGray" VerticalAlignment="Stretch" Width="70" IsHitTestVisible="True" MouseEnter="MouseEnterMainMenu" MouseLeave="MouseLeaveMainMenu" ToolTip="Main Menu" MouseLeftButtonDown="OnClickMainMenu" Cursor="Hand">
                    <Image Name="menuItemImage" Source="Photos\tab_icon.png" Height="50" Width="50"/>
                </Grid>

                <MenuItem Name="tabMenuButton" Visibility="Collapsed">
                    <MenuItem.ContextMenu>
                        <ContextMenu Closed="OnClosedMenuContectMenu">
                            <MenuItem Header="DashBoard" Name="dashboardMenuItem" Click="DashboardMenuSelection"/>
                            <MenuItem Header="Employees" Name="EmployeeMenuItem" Click="employeeMenuSelection"/>
                            <MenuItem Header="Companies" Name="CompanyMenuItem" Click="companyMenuSelection"/>
                            <MenuItem Header="Company Equipment" Name="CompanyEquipmentMenuItem" Click="CompanyEquipmentMenuSelection"/>
                            <MenuItem Header="Sites" Name="sitesMenuItem" Click="SitesMenuSelection"/>
                            <MenuItem Header="EMF" Name="emfMenuItem" IsChecked="True" IsHitTestVisible="False"/>
                            <MenuItem Header="Complaints" Name="ComplaintsMenuItem" Click="ComplaintsMenuSelection"/>
                            <MenuItem Header="Monitoring Missions" Name="monitoringMenuItem" Click="MonitoringMenuSelection"/>
                            <MenuItem Header="Inspection Missions" Name="inspectionMenuItem" Click="InspectionMenuSelection"/>
                        </ContextMenu>
                    </MenuItem.ContextMenu>
                </MenuItem>

                <Image Source="Photos\NTRA_white1.png" VerticalAlignment="Center" Height="200"  HorizontalAlignment="Left"/>
            </WrapPanel>

            <Grid Name="userNameGrid" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Name="userNameLabel" Foreground="White" FontSize="20" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Content="Username:"/>
                <Button Grid.Row="1" Name="logoutButton" Content="Sign out" Style="{StaticResource buttonStyle}" VerticalAlignment="Bottom" Background="LightGray" FontWeight="Bold" Foreground="#000080" Click="OnClickLogoutButton"/>
            </Grid>

            <Button Grid.Column="1" Name="changePasswordButton" Content="Change Password" VerticalAlignment="Bottom" FontWeight="Bold" Style="{StaticResource negativeButtonStyle}" Width="200" Click="OnClickChangePasswordButton"/>

        </Grid>

        <!--<ScrollViewer Grid.Row="1">
        <WebBrowser  x:Name="wbMaps" Source="https://www.google.com/maps" GotTouchCapture="wbMaps_GotTouchCapture" Navigated="wbMaps_Navigated" Navigating="wbMaps_Navigating"/>
        </ScrollViewer>-->

        <Label Grid.Row="1" Style="{StaticResource headerLabelStyle}" Content="EMF" HorizontalAlignment="Center" Foreground="#000080"/>


        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                <Grid >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="70"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Row="0" Grid.Column="0" Name="assignedEngineerCheckBox" Content="Assigned: " Checked="OnCheckAssignedCheckBox" Unchecked="OnUncheckAssignedCheckBox" Style="{StaticResource checkBoxStyle}"/>
                    <CheckBox Grid.Row="1" Grid.Column="0" Name="planStatusCheckBox" Content="Plan &#10;status: " Checked="OnCheckPlanStatusCheckBox" Unchecked="OnUncheckPlanStatusCheckBox" Style="{StaticResource checkBoxStyle}"/>
                    <CheckBox Grid.Row="2" Grid.Column="0" Name="statusCheckBox" Content="Point &#10;status: " Checked="OnCheckStatusCheckBox" Unchecked="OnUncheckStatusCheckBox" Style="{StaticResource checkBoxStyle}"/>
                    <CheckBox Grid.Row="3" Grid.Column="0" Name="nameCheckBox" Content="Name: " Checked="OnCheckNameCheckBox" Unchecked="OnUncheckNameCheckBox" Style="{StaticResource checkBoxStyle}"/>
                    <CheckBox Grid.Row="4" Grid.Column="0" Name="areaCheckBox" Content="Area: " Checked="OnCheckAreaCheckBox" Unchecked="OnUncheckAreaCheckBox" Style="{StaticResource checkBoxStyle}"/>
                    <CheckBox Grid.Row="5" Grid.Column="0" Name="districtCheckBox" Content="District: " Checked="OnCheckDistrictCheckBox" Unchecked="OnUncheckDistrictCheckBox" Style="{StaticResource checkBoxStyle}"/>
                    <CheckBox Grid.Row="6" Grid.Column="0" Name="latCheckBox" Content="Latitude: " Checked="OnCheckLatCheckBox" Unchecked="OnUncheckLatCheckBox" Style="{StaticResource checkBoxStyle}"/>
                    <CheckBox Grid.Row="7" Grid.Column="0" Name="longCheckBox" Content="Longitude: " Checked="OnCheckLongCheckBox" Unchecked="OnUncheckLongCheckBox" Style="{StaticResource checkBoxStyle}"/>
                    <CheckBox Grid.Row="8" Grid.Column="0" Name="actualLatCheckBox" Content="Actual &#10;lat: " Checked="OnCheckactualLatCheckBoxCheckBox" Unchecked="OnUncheckactualLatCheckBoxCheckBox" Style="{StaticResource checkBoxStyle}"/>
                    <CheckBox Grid.Row="9" Grid.Column="0" Name="actualLongCheckBox" Content="Actual &#10;long: " Checked="OnCheckActualLongCheckBox" Unchecked="OnUncheckActualLongCheckBox" Style="{StaticResource checkBoxStyle}"/>
                    
                    <ComboBox Grid.Row="0" Grid.Column="1" Name="assignedComboBox" SelectionChanged="OnSelChangedAssignedComboBox" Style="{StaticResource miniComboBoxStyle}" IsEnabled='False'/>
                    <ComboBox Grid.Row="1" Grid.Column="1" Name="planStatusComboBox" SelectionChanged="OnSelChangedPlanStatusComboBox" Style="{StaticResource miniComboBoxStyle}" IsEnabled='False'/>
                    <ComboBox Grid.Row="2" Grid.Column="1" Name="statusComboBox" SelectionChanged="OnSelChangedStatusComboBox" Style="{StaticResource miniComboBoxStyle}" IsEnabled='False'/>
                    <TextBox Grid.Row="3" Grid.Column="1" Name="nameTextBox" TextChanged="OnTextChangedSearchTextBox" Style="{StaticResource miniTextboxStyle}" IsEnabled='False'/>
                    <TextBox Grid.Row="4" Grid.Column="1" Name="areaTextBox" TextChanged="OnTextChangedSearchTextBox" Style="{StaticResource miniTextboxStyle}" IsEnabled='False'/>
                    <TextBox Grid.Row="5" Grid.Column="1" Name="districtTextBox" TextChanged="OnTextChangedSearchTextBox" Style="{StaticResource miniTextboxStyle}" IsEnabled='False'/>
                    <TextBox Grid.Row="6" Grid.Column="1" Name="latTextBox" TextChanged="OnTextChangedSearchTextBox" Style="{StaticResource miniTextboxStyle}" IsEnabled='False'/>
                    <TextBox Grid.Row="7" Grid.Column="1" Name="longTextBox" TextChanged="OnTextChangedSearchTextBox" Style="{StaticResource miniTextboxStyle}" IsEnabled='False'/>
                    <TextBox Grid.Row="8" Grid.Column="1" Name="actualLatTextBox" TextChanged="OnTextChangedSearchTextBox" Style="{StaticResource miniTextboxStyle}" IsEnabled='False'/>
                    <TextBox Grid.Row="9" Grid.Column="1" Name="actualLongTextBox" TextChanged="OnTextChangedSearchTextBox" Style="{StaticResource miniTextboxStyle}" IsEnabled='False'/>
                    
                </Grid>
            </ScrollViewer>

            <Grid Grid.Column="1" Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Border Name="listViewBorder" CornerRadius="0,30,0,0" BorderThickness="3" BorderBrush="#000080" Background="White" Width="150" MouseLeftButtonDown="OnClickListView">
                        <Label Style="{StaticResource mediumLabelStyle}" Content="EMF Points" Foreground="#000080" HorizontalAlignment="Left" FontWeight="Bold"/>
                    </Border>
                    <Border Name="tableViewBorder" CornerRadius="0,30,0,0" BorderThickness="3" BorderBrush="#000080" Background="#000080" Width="150" MouseLeftButtonDown="OnClickTableView">
                        <Label Style="{StaticResource mediumLabelStyle}" Content="EMF Plans" Foreground="White" HorizontalAlignment="Left" FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <ScrollViewer Grid.Row="1" Name="listViewScrollViewer" VerticalContentAlignment="Stretch" >
                    <StackPanel Name="pointsStackPanel" Background="White"/>
                </ScrollViewer>
                <ScrollViewer Grid.Row="1" Name="tableViewScrollViewer"  Visibility="Collapsed" HorizontalScrollBarVisibility="Auto">
                    <StackPanel Name="plansStackPanel" Background="White"/>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>


            <Button Grid.Column="0" Style="{StaticResource buttonStyle}" Content="Add Point" Click="OnBtnClickAdd"/>
            <Button Grid.Column="1" Style="{StaticResource buttonStyle}" Content="Add Plan" Click="OnBtnClickAddPlan"/>
        </Grid>
    </Grid>
</Page>
