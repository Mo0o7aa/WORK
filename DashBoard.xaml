<Page x:Class="ntra_missions.DashBoard"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ntra_missions"
      xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
      mc:Ignorable="d" 
      Title="DashBoard">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="150"/>
            <RowDefinition Height="100"/>
            <RowDefinition/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#000080">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <WrapPanel>
                <Grid Name="mainMenuGrid" Background="LightGray" VerticalAlignment="Stretch" Width="70" IsHitTestVisible="True" MouseEnter="MouseEnterMainMenu" MouseLeave="MouseLeaveMainMenu" ToolTip="Main Menu" MouseLeftButtonDown="OnClickMainMenu" Cursor="Hand">
                    <Image Name="menuItemImage" Source="Photos\tab_icon.png" Height="50" Width="50"/>
                </Grid>

                <MenuItem Name="tabMenuButton" Visibility="Collapsed">
                    <MenuItem.ContextMenu>
                        <ContextMenu Closed="OnClosedMenuContectMenu">
                            <MenuItem Header="DashBoard" Name="dashboardMenuItem"  IsChecked="True" IsHitTestVisible="False"/>
                            <MenuItem Header="Employees" Name="EmployeeMenuItem" Click="employeeMenuSelection"/>
                            <MenuItem Header="Companies" Name="CompanyMenuItem" Click="CompanyMenuSelection"/>
                            <MenuItem Header="Company Equipment" Name="CompanyEquipmentMenuItem" Click="CompanyEquipmentMenuSelection"/>
                            <MenuItem Header="Sites" Name="sitesMenuItem" Click="SitesMenuSelection"/>
                            <MenuItem Header="EMF" Name="emfMenuItem" Click="emfMenuSelection"/>
                            <MenuItem Header="Complaints" Name="ComplaintsMenuItem" Click="ComplaintsMenuSelection"/>
                            <MenuItem Header="Monitoring Missions" Name="monitoringMenuItem" Click="MonitoringMenuSelection"/>
                            <MenuItem Header="Repeaters" Name="repeatersMenuItem" Click="RepeatersMenueSelection"/>
                            <MenuItem Header="Inspection Missions" Name="inspectionMenuItem" Click="InspectionMenuSelection"/>
                        </ContextMenu>
                    </MenuItem.ContextMenu>
                </MenuItem>

                <Image Source="Photos\NTRA_white1.png" VerticalAlignment="Center" Height="200"  HorizontalAlignment="Left"/>
            </WrapPanel>

            <Grid Name="userNameGrid" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Name="userNameLabel" Foreground="White" FontSize="20" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Content="Username:"/>
                <Button Grid.Row="1" Name="logoutButton" Content="Sign out" Style="{StaticResource buttonStyle}" VerticalAlignment="Bottom" Background="LightGray" FontWeight="Bold" Foreground="#000080" Click="OnClickLogoutButton"/>
            </Grid>

            <Button Grid.Column="1" Name="changePasswordButton" Content="Change Password" VerticalAlignment="Bottom" FontWeight="Bold" Style="{StaticResource negativeButtonStyle}" Width="200" Click="OnClickChangePasswordButton"/>

        </Grid>


        <Label Grid.Row="1" Style="{StaticResource headerLabelStyle}" Content="DASHBOARD" HorizontalAlignment="Center" Foreground="#000080"/>




            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="100"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Height="100">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Label Content="Start Date" Style="{StaticResource labelStyle}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12"/>
                        <DatePicker Name="startDatePicker" Style="{StaticResource datePickerStyle}" HorizontalAlignment="Center" SelectedDateChanged="OnSelChangedStartDatePicker"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <Label Content="End Date" Style="{StaticResource labelStyle}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12"/>
                        <DatePicker Name="endDatePicker" Style="{StaticResource datePickerStyle}" HorizontalAlignment="Center" SelectedDateChanged="OnSelChangedEndDatePicker"/>
                    </StackPanel>

                <StackPanel Grid.Column="2">
                    <Label Content="Category" Style="{StaticResource labelStyle}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12"/>
                    <ComboBox Name="categoryCombo" Style="{StaticResource comboBoxStyle}" HorizontalAlignment="Center" SelectionChanged="onselChangedCategoryCombo"/>
                </StackPanel>

            </Grid>

                <ScrollViewer Grid.Row="1" Background="White" Margin="24">
                    <Grid >
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" BorderBrush ="LightGray"  BorderThickness="5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition Height="200"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.ColumnSpan="2" Content="Number of Sites" Style="{StaticResource stackPanelHeaderLabelStyle}" />
                                <Grid Grid.Row="1" Grid.Column="0" Name="numberOfSitesGrid" ShowGridLines="True" Margin="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <Label Content="Company" Style="{StaticResource stackPanelSecondaryHeaderLabelStyle}"/>
                                    <Label Grid.Column="1" Content="No. of Sites" Style="{StaticResource stackPanelSecondaryHeaderLabelStyle}"/>
                                    <Label Grid.Row="1" Grid.Column="0" Content="Vodafone" Style="{StaticResource labelStyleBlack}" HorizontalContentAlignment="Center"/>
                                    <Label Grid.Row="2" Grid.Column="0" Content="Etisalat" Style="{StaticResource labelStyleBlack}" HorizontalContentAlignment="Center"/>
                                    <Label Grid.Row="3" Grid.Column="0" Content="Orange" Style="{StaticResource labelStyleBlack}" HorizontalContentAlignment="Center"/>
                                    <Label Grid.Row="4" Grid.Column="0" Content="WE" Style="{StaticResource labelStyleBlack}" HorizontalContentAlignment="Center"/>
                                </Grid>
                                <lvc:PieChart Grid.Column="1" Name="numberOfSitesPieChart" LegendLocation="Right" Grid.ColumnSpan="2" Margin="12" Grid.Row="1" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="1" BorderBrush ="LightGray"  BorderThickness="5">
                            <Grid >
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition Height="200"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.ColumnSpan="2" Content="Number of Complaints" Style="{StaticResource stackPanelHeaderLabelStyle}"/>
                                <Grid Grid.Row="1" Grid.Column="0" Name="numberOfComplaintsGrid" ShowGridLines="True" Margin="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <Label Content="Company" Style="{StaticResource stackPanelSecondaryHeaderLabelStyle}"/>
                                    <Label Grid.Column="1" Content="No. of Sites" Style="{StaticResource stackPanelSecondaryHeaderLabelStyle}"/>
                                    <Label Grid.Row="1" Grid.Column="0" Content="Vodafone" Style="{StaticResource labelStyleBlack}" HorizontalContentAlignment="Center"/>
                                    <Label Grid.Row="2" Grid.Column="0" Content="Etisalat" Style="{StaticResource labelStyleBlack}" HorizontalContentAlignment="Center"/>
                                    <Label Grid.Row="3" Grid.Column="0" Content="Orange" Style="{StaticResource labelStyleBlack}" HorizontalContentAlignment="Center"/>
                                    <Label Grid.Row="4" Grid.Column="0" Content="WE" Style="{StaticResource labelStyleBlack}" HorizontalContentAlignment="Center"/>
                                </Grid>
                                <lvc:PieChart Grid.Row="1" Grid.Column="1" Name="numberOfComplaintsPieChart" LegendLocation="Right" Margin="12"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" Name="vodafoneComplaintsBorder" BorderBrush ="LightGray"  BorderThickness="5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition Height="200"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <Label Grid.ColumnSpan="2" Content="Vodafone Complaint Status" Style="{StaticResource stackPanelHeaderLabelStyle}"/>




                                <Grid Grid.Row="1" Grid.Column="0" Name="vodafoneComplaintsGrid" ShowGridLines="True" Margin="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <Label Content="Status" Style="{StaticResource stackPanelSecondaryHeaderLabelStyle}"/>
                                    <Label Grid.Column="1" Content="Complaints" Style="{StaticResource stackPanelSecondaryHeaderLabelStyle}"/>
                                    <Label Grid.Row="1" Grid.Column="0" Content="Open" Style="{StaticResource labelStyleBlack}" HorizontalContentAlignment="Center"/>
                                    <Label Grid.Row="2" Grid.Column="0" Content="Pending" Style="{StaticResource labelStyleBlack}" HorizontalContentAlignment="Center"/>
                                    <Label Grid.Row="3" Grid.Column="0" Content="Closed" Style="{StaticResource labelStyleBlack}" HorizontalContentAlignment="Center"/>
                                </Grid>
                                <lvc:PieChart Grid.Row="1" Grid.Column="1" Name="vodafoneComplaintsPieChart" LegendLocation="Right" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="12"/>
                            </Grid>
                        </Border>


                        <Border Grid.Row="1" Grid.Column="1" Name="etislatComplaintsBorder" BorderBrush ="LightGray"  BorderThickness="5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition Height="200"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.ColumnSpan="2" Content="Etisalat Complaint Status" Style="{StaticResource stackPanelHeaderLabelStyle}" Margin="0,2,0,2"/>
                                


                                <Grid Grid.Row="2" Grid.Column="0" Name="etisalatComplaintsGrid" ShowGridLines="True" Margin="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <Label Content="Status" Style="{StaticResource stackPanelSecondaryHeaderLabelStyle}"/>
                                    <Label Grid.Column="1" Content="Complaints" Style="{StaticResource stackPanelSecondaryHeaderLabelStyle}"/>
                                    <Label Grid.Row="1" Grid.Column="0" Content="Open" Style="{StaticResource labelStyleBlack}" HorizontalContentAlignment="Center"/>
                                    <Label Grid.Row="2" Grid.Column="0" Content="Pending" Style="{StaticResource labelStyleBlack}" HorizontalContentAlignment="Center"/>
                                    <Label Grid.Row="3" Grid.Column="0" Content="Closed" Style="{StaticResource labelStyleBlack}" HorizontalContentAlignment="Center"/>
                                    
                                </Grid>
                                
                                <lvc:PieChart Grid.Row="3" Grid.Column="1" Name="etislataComplaintsPieChart" LegendLocation="Right" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="12"/>

                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="0" Name="orangeComplaintsBorder" BorderBrush ="LightGray"  BorderThickness="5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition Height="200"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <Label Grid.ColumnSpan="2" Content="Orange Complaint Status" Style="{StaticResource stackPanelHeaderLabelStyle}"/>


                                <Grid Grid.Row="3" Grid.Column="0" Name="orangeComplaintsGrid" ShowGridLines="True" Margin="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>

                                    <Label Content="Status" Style="{StaticResource stackPanelSecondaryHeaderLabelStyle}"/>
                                    <Label Grid.Column="1" Content="Complaints" Style="{StaticResource stackPanelSecondaryHeaderLabelStyle}"/>
                                    <Label Grid.Row="1" Grid.Column="0" Content="Open" Style="{StaticResource labelStyleBlack}" HorizontalContentAlignment="Center"/>
                                    <Label Grid.Row="2" Grid.Column="0" Content="Pending" Style="{StaticResource labelStyleBlack}" HorizontalContentAlignment="Center"/>
                                    <Label Grid.Row="3" Grid.Column="0" Content="Closed" Style="{StaticResource labelStyleBlack}" HorizontalContentAlignment="Center"/>
                                </Grid>
                                <lvc:PieChart Grid.Row="2" Grid.Column="1" Name="orangeComplaintsPieChart" LegendLocation="Right" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="12"/>
                                 </Grid>
                        </Border>

                    </Grid>
                </ScrollViewer>

            </Grid>




    </Grid>
</Page>
