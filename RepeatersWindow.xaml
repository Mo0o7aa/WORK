<Window x:Class="ntra_missions.RepeatersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ntra_missions"
        mc:Ignorable="d"
        Title="Repeaters Window" Height="600" Width="800" Background="LightGray">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition/>
            <RowDefinition Height="75"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource navyblue}">
            <Image Source="Photos\NTRA_white1.png" VerticalAlignment="Center" Height="200"  HorizontalAlignment="Left"/>
            <Label Name="headerLabel" Content="Repeaters" Style="{StaticResource headerLabelStyle}" HorizontalAlignment="Center"/>
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="24">
            <StackPanel Name="repeatersStackPanel">
                <Grid Name="mainGrid" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="50"/>
                    </Grid.RowDefinitions>

                    <Label Content="Repeater 1" Style="{StaticResource stackPanelHeaderLabelStyle}" Grid.Row="0" Grid.ColumnSpan="2" Height="50"/>

                    <WrapPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Label Content="Lat: " Style="{StaticResource labelStyleBlack}"/>
                        <TextBox Name="latTextBox" Style="{StaticResource textboxStyle}"  PreviewTextInput="NumberValidationTextBox"/>
                    </WrapPanel>

                    <WrapPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Label Content="Long: " Style="{StaticResource labelStyleBlack}"/>
                        <TextBox Name="longTextBox" Style="{StaticResource textboxStyle}"  PreviewTextInput="NumberValidationTextBox"/>
                    </WrapPanel>

                    <WrapPanel Grid.Row="2" Grid.ColumnSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Label Content="Address: " Style="{StaticResource labelStyleBlack}"/>
                        <TextBox Name="addressTextBox" Style="{StaticResource wideTextboxStyle}"/>
                    </WrapPanel>

                    <WrapPanel Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Label Content="Date: " Style="{StaticResource labelStyleBlack}"/>
                        <DatePicker Name="dateLocatedPicker" Style="{StaticResource datePickerStyle}"  PreviewTextInput="NumberValidationTextBox"/>
                    </WrapPanel>

                    <WrapPanel Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Label Content="Staus: " Style="{StaticResource labelStyleBlack}"/>
                        <ComboBox Name="statusComboBox" Style="{StaticResource comboBoxStyle}" />
                    </WrapPanel>

                    <WrapPanel Grid.Row="4" Grid.ColumnSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Label Content="Mission (Optional): " Style="{StaticResource wideLabelStyleBlack}"/>
                        <ComboBox Name="missionComboBox" Style="{StaticResource comboBoxStyle}"  SelectionChanged="OnSelChangedMissionCombo"/>
                    </WrapPanel>

                    

                </Grid>

                <Image Source="Photos/plus_icon.png" Height="30" Width="30" HorizontalAlignment="Center" Margin="24" ToolTip="Click to add repeater" MouseLeftButtonDown="OnClickAddRepeater"/>

            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Name="buttonsGrid" >
            <Button Grid.Column="2" Name="finishButton" Content="Save Changes" Style="{StaticResource buttonStyle}" Click='OnButtonClickSaveChanges'/>
        </Grid>
    </Grid>
</Window>
