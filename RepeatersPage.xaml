<Page x:Class="ntra_missions.RepeatersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:ntra_missions"
      mc:Ignorable="d"
      Title="RepeatersPage"
      Background="#EEF2FA">

    <Page.Resources>
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D7DFEF"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="SmallBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="#EDF2FF"/>
        </Style>
    </Page.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="126"/>
            <RowDefinition Height="88"/>
            <RowDefinition/>
            <RowDefinition Height="94"/>
        </Grid.RowDefinitions>

        <!-- Top application bar -->
        <Border Grid.Row="0" Background="#000080" CornerRadius="18" BorderBrush="#1D2E8A" BorderThickness="1" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="260"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="62" Height="62" CornerRadius="12" Background="#DFE4F7" Margin="0,0,14,0">
                        <Grid Name="mainMenuGrid"
                              Cursor="Hand"
                              ToolTip="Main Menu"
                              MouseEnter="MouseEnterMainMenu"
                              MouseLeave="MouseLeaveMainMenu"
                              MouseLeftButtonDown="OnClickMainMenu">
                            <Image Name="menuItemImage" Source="Photos\tab_icon.png" Height="34" Width="34"/>
                        </Grid>
                    </Border>

                    <MenuItem Name="tabMenuButton" Visibility="Collapsed">
                        <MenuItem.ContextMenu>
                            <ContextMenu Closed="OnClosedMenuContectMenu">
                                <MenuItem Header="DashBoard" Name="dashboardMenuItem" Click="DashboardMenuSelection"/>
                                <MenuItem Header="Employees" Name="EmployeeMenuItem" Click="employeeMenuSelection"/>
                                <MenuItem Header="Companies" Name="CompanyMenuItem" Click="CompanyMenuSelection"/>
                                <MenuItem Header="Company Equipment" Name="CompanyEquipmentMenuItem" Click="CompanyEquipmentMenuSelection"/>
                                <MenuItem Header="Sites" Name="sitesMenuItem" Click="SitesMenuSelection"/>
                                <MenuItem Header="EMF" Name="emfMenuItem" Click="emfMenuSelection"/>
                                <MenuItem Header="Complaints" Name="ComplaintsMenuItem" Click="ComplaintsMenuSelection"/>
                                <MenuItem Header="Monitoring Missions" Name="monitoringMenuItem" Click="MonitoringMenuSelection"/>
                                <MenuItem Header="Repeaters" Name="repeatersMenuItem" IsChecked="True" IsHitTestVisible="False"/>
                                <MenuItem Header="Inspection Missions" Name="inspectionMenuItem" Click="InspectionMenuSelection"/>
                            </ContextMenu>
                        </MenuItem.ContextMenu>
                    </MenuItem>

                    <StackPanel VerticalAlignment="Center">
                        <Image Source="Photos\NTRA_white1.png" Height="72"/>
                        <TextBlock Text="Spectrum Monitoring Workspace"
                                   Margin="4,2,0,0"
                                   Foreground="#DBE3FF"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1"
                        Name="changePasswordButton"
                        Content="Change Password"
                        Style="{StaticResource negativeButtonStyle}"
                        Width="188"
                        Height="42"
                        FontWeight="Bold"
                        VerticalAlignment="Bottom"
                        Click="OnClickChangePasswordButton"/>

                <Border Grid.Column="2" Background="#1D2C89" CornerRadius="12" Padding="12,8">
                    <Grid Name="userNameGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0"
                               Name="userNameLabel"
                               Content="Username:"
                               Foreground="White"
                               FontSize="18"
                               HorizontalContentAlignment="Center"
                               VerticalContentAlignment="Center"/>
                        <Button Grid.Row="1"
                                Name="logoutButton"
                                Content="Sign out"
                                Style="{StaticResource buttonStyle}"
                                Width="130"
                                Height="32"
                                HorizontalAlignment="Center"
                                Background="#F2F4FC"
                                Foreground="#000080"
                                FontWeight="Bold"
                                Click="OnClickLogoutButton"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Page heading -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,14,0,0" Padding="18,10">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Repeaters" FontSize="30" FontWeight="Bold" Foreground="#000080"/>
                    <TextBlock Text="Filter, review, and export repeaters with a cleaner workflow"
                               FontSize="13"
                               Foreground="#4A5779"/>
                </StackPanel>

                <Border DockPanel.Dock="Right" Style="{StaticResource SmallBadgeStyle}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Live data + same business logic"
                                   Foreground="#274183"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Filters -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Filters" FontSize="18" FontWeight="Bold" Foreground="#000080"/>
                        <TextBlock Text="Choose criteria"
                                   DockPanel.Dock="Right"
                                   VerticalAlignment="Center"
                                   Foreground="#6A7696"
                                   FontSize="12"/>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Grid Margin="0,6,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="64"/>
                                <RowDefinition Height="64"/>
                                <RowDefinition Height="64"/>
                                <RowDefinition Height="64"/>
                                <RowDefinition Height="64"/>
                                <RowDefinition Height="64"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Row="0" Grid.Column="0" Name="searchLatCheckBox" Content="Search &#10;Lat" Checked="OnCheckSearchLatCheckBox" Unchecked="OnUncheckSearchCheckBox" Style="{StaticResource checkBoxStyle}" Cursor="Hand"/>
                            <CheckBox Grid.Row="1" Grid.Column="0" Name="searchLongCheckBox" Content="Search &#10;Long" Checked="OnCheckSearchLongCheckBox" Unchecked="OnUncheckSearchLongCheckBox" Style="{StaticResource checkBoxStyle}" Cursor="Hand"/>
                            <CheckBox Grid.Row="2" Grid.Column="0" Name="cityCheckBox" Content="City" Checked="OnCheckCityCheckBox" Unchecked="OnUncheckCityCheckBox" Style="{StaticResource checkBoxStyle}" Cursor="Hand"/>
                            <CheckBox Grid.Row="3" Grid.Column="0" Name="areaCheckBox" Content="Area" Checked="OnCheckAreaCheckBox" Unchecked="OnUnCheckAreaCheckBox" Style="{StaticResource checkBoxStyle}" Cursor="Hand"/>
                            <CheckBox Grid.Row="4" Grid.Column="0" Name="statusCheckBox" Content="Status" Checked="OnCheckStatusCheckBox" Unchecked="OnUncheckStatusCheckBox" Style="{StaticResource checkBoxStyle}" Cursor="Hand"/>

                            <TextBox Grid.Row="0" Grid.Column="1" Name="latTextBox" TextChanged="OnTextChangedLatTextBox" Style="{StaticResource miniTextboxStyle}" IsEnabled="False"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Name="longTextBox" TextChanged="OnTextChangedLongTextBox" Style="{StaticResource miniTextboxStyle}" IsEnabled="False"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" Name="cityComboBox" SelectionChanged="OnSelChangedCityCombo" Style="{StaticResource miniComboBoxStyle}" IsEnabled="False"/>
                            <ComboBox Grid.Row="3" Grid.Column="1" Name="areaComboBox" SelectionChanged="OnSelChangedAreaCombo" Style="{StaticResource miniComboBoxStyle}" IsEnabled="False"/>
                            <ComboBox Grid.Row="4" Grid.Column="1" Name="statusComboBox" SelectionChanged="OnSelChangedStatusCombo" Style="{StaticResource miniComboBoxStyle}" IsEnabled="False"/>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Results -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Border Name="listViewBorder" CornerRadius="10,10,0,0" BorderThickness="2" BorderBrush="#000080" Background="White" Width="150" Height="42" MouseLeftButtonDown="OnClickListView" Margin="0,0,8,0">
                                <Label Style="{StaticResource mediumLabelStyle}" Content="List View" Foreground="#000080" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                            </Border>
                            <Border Name="tableViewBorder" CornerRadius="10,10,0,0" BorderThickness="2" BorderBrush="#000080" Background="#000080" Width="150" Height="42" MouseLeftButtonDown="OnClickTableView">
                                <Label Style="{StaticResource mediumLabelStyle}" Content="Table View" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>

                        <Border DockPanel.Dock="Right" Style="{StaticResource SmallBadgeStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Label Style="{StaticResource wideLabelStyle}" Content="Repeaters Count:" Padding="3,0"/>
                                <Label Name="countLabel" Style="{StaticResource labelStyle}" Padding="3,0"/>
                            </StackPanel>
                        </Border>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" Name="listViewScrollViewer" VerticalContentAlignment="Stretch" Background="White">
                        <StackPanel Name="repeatersStackPanel" Background="White"/>
                    </ScrollViewer>

                    <ScrollViewer Grid.Row="1" Name="tableViewScrollViewer" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" Background="White">
                        <DataGrid Name="repeatersGrid" Background="White"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer actions -->
        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Margin="0,14,0,0" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource buttonStyle}" Content="Add" Click="OnBtnClickAdd" Margin="8,4"/>
                <Button Grid.Column="1" Style="{StaticResource buttonStyle}" Content="Export" Click="OnBtnClickExport" Margin="8,4"/>
                <Button Grid.Column="2" Style="{StaticResource buttonStyle}" Content="Excel Format" Click="OnBtnClickFormat" Margin="8,4"/>
                <Button Grid.Column="3" Style="{StaticResource buttonStyle}" Content="Re Import" Click="OnBtnClickReImport" Margin="8,4"/>
            </Grid>
        </Border>
    </Grid>
</Page>
