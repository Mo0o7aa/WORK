<Page x:Class="ntra_missions.RepeatersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:ntra_missions"
      mc:Ignorable="d"
      Title="RepeatersPage">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <local:PageHeader x:Name="pageHeader" Title="Repeaters" CurrentTag="Repeaters"/>

        <Grid Grid.Row="1" Margin="16,16,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Filters -->
            <Border Style="{StaticResource CardBorder}" VerticalAlignment="Top" Margin="0,44,16,0">
                <StackPanel>
                    <TextBlock Text="Filters" Style="{StaticResource CardTitleText}" Margin="0,0,0,12"/>

                    <CheckBox Name="searchLatCheckBox" Content="Search Lat" Style="{StaticResource checkBoxStyle}" Width="Auto"
                              Checked="OnCheckSearchLatCheckBox" Unchecked="OnUncheckSearchCheckBox"/>
                    <TextBox Name="latTextBox" Style="{StaticResource ModernTextBoxBase}" Margin="0,6,0,14" IsEnabled="False"
                             TextChanged="OnTextChangedLatTextBox"/>

                    <CheckBox Name="searchLongCheckBox" Content="Search Long" Style="{StaticResource checkBoxStyle}" Width="Auto"
                              Checked="OnCheckSearchLongCheckBox" Unchecked="OnUncheckSearchLongCheckBox"/>
                    <TextBox Name="longTextBox" Style="{StaticResource ModernTextBoxBase}" Margin="0,6,0,14" IsEnabled="False"
                             TextChanged="OnTextChangedLongTextBox"/>

                    <CheckBox Name="cityCheckBox" Content="City" Style="{StaticResource checkBoxStyle}" Width="Auto"
                              Checked="OnCheckCityCheckBox" Unchecked="OnUncheckCityCheckBox"/>
                    <ComboBox Name="cityComboBox" Style="{StaticResource miniComboBoxStyle}" Width="Auto" HorizontalAlignment="Stretch"
                              Margin="0,6,0,14" IsEnabled="False" SelectionChanged="OnSelChangedCityCombo"/>

                    <CheckBox Name="areaCheckBox" Content="Area" Style="{StaticResource checkBoxStyle}" Width="Auto"
                              Checked="OnCheckAreaCheckBox" Unchecked="OnUnCheckAreaCheckBox"/>
                    <ComboBox Name="areaComboBox" Style="{StaticResource miniComboBoxStyle}" Width="Auto" HorizontalAlignment="Stretch"
                              Margin="0,6,0,14" IsEnabled="False" SelectionChanged="OnSelChangedAreaCombo"/>

                    <CheckBox Name="statusCheckBox" Content="Status" Style="{StaticResource checkBoxStyle}" Width="Auto"
                              Checked="OnCheckStatusCheckBox" Unchecked="OnUncheckStatusCheckBox"/>
                    <ComboBox Name="statusComboBox" Style="{StaticResource miniComboBoxStyle}" Width="Auto" HorizontalAlignment="Stretch"
                              Margin="0,6,0,0" IsEnabled="False" SelectionChanged="OnSelChangedStatusCombo"/>
                </StackPanel>
            </Border>

            <!-- Content -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Name="listViewToggle" Style="{StaticResource TogglePill}" Content="List View" IsChecked="True"
                                 Checked="OnCheckedListView"/>
                    <RadioButton Name="tableViewToggle" Style="{StaticResource TogglePill}" Content="Table View"
                                 Checked="OnCheckedTableView"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Repeaters Count: " Style="{StaticResource FieldLabelText}"/>
                    <TextBlock Name="countText" Style="{StaticResource ValueTextBrand}"/>
                </StackPanel>

                <!-- List view -->
                <ListBox Grid.Row="1" Name="repeatersList" Style="{StaticResource CardList}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource RowCardBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="300"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <TextBlock Text="Serial:  " Style="{StaticResource FieldLabelText}"/>
                                            <TextBlock Text="{Binding Serial}" Style="{StaticResource ValueTextBrand}" Margin="0,0,20,0"/>
                                            <TextBlock Text="City:  " Style="{StaticResource FieldLabelText}"/>
                                            <TextBlock Text="{Binding City}" Style="{StaticResource ValueText}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                                            <TextBlock Text="Area:  " Style="{StaticResource FieldLabelText}"/>
                                            <TextBlock Text="{Binding Area}" Style="{StaticResource ValueText}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2">
                                            <TextBlock Text="Coordinates:  " Style="{StaticResource FieldLabelText}"/>
                                            <TextBlock Text="{Binding Coordinates}" Style="{StaticResource ValueTextBrand}"
                                                       Cursor="Hand" ToolTip="Left click to Copy coordinates!"
                                                       Tag="{Binding}" MouseLeftButtonDown="OnClickCopyCoordinates"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                                            <TextBlock Text="Address:  " Style="{StaticResource FieldLabelText}"/>
                                            <TextBlock Text="{Binding Address}" Style="{StaticResource ValueText}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,2">
                                            <TextBlock Text="Added By:  " Style="{StaticResource FieldLabelText}"/>
                                            <TextBlock Text="{Binding AddedBy}" Style="{StaticResource ValueText}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                                            <TextBlock Text="Comment:  " Style="{StaticResource FieldLabelText}"/>
                                            <TextBlock Text="{Binding Comment}" Style="{StaticResource ValueText}"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right">
                                        <Border Style="{StaticResource StatusPillBorder}" Background="{Binding StatusBrush}"
                                                HorizontalAlignment="Right" Margin="0,0,0,8">
                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusPillText}"/>
                                        </Border>
                                        <Button Style="{StaticResource RowButtonFilled}" Content="Edit" Tag="{Binding}"
                                                HorizontalAlignment="Right" Click="OnClickEdit"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Table view -->
                <DataGrid Grid.Row="1" Name="repeatersDataGrid" Style="{StaticResource ModernDataGrid}" Visibility="Collapsed">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Serial" Binding="{Binding Serial}" Width="90"/>
                        <DataGridTextColumn Header="City" Binding="{Binding City}" Width="110"/>
                        <DataGridTextColumn Header="Area" Binding="{Binding Area}" Width="140"/>
                        <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="*"/>
                        <DataGridTextColumn Header="Latitude" Binding="{Binding Latitude}" Width="110"/>
                        <DataGridTextColumn Header="Longitude" Binding="{Binding Longitude}" Width="110"/>
                        <DataGridTextColumn Header="Comment" Binding="{Binding Comment}" Width="160"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="110"/>
                        <DataGridTextColumn Header="Added By" Binding="{Binding AddedBy}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <!-- Actions -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="0,1,0,0" Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Style="{StaticResource PrimaryButton}" Content="Add" Click="OnBtnClickAdd" Margin="6,0"/>
                <Button Style="{StaticResource SecondaryButton}" Content="Export" Click="OnBtnClickExport" Margin="6,0"/>
                <Button Style="{StaticResource SecondaryButton}" Content="Excel Format" Click="OnBtnClickFormat" Margin="6,0"/>
                <Button Style="{StaticResource SecondaryButton}" Content="Re Import" Click="OnBtnClickReImport" Margin="6,0"/>
                <Button Style="{StaticResource SecondaryButton}" Content="Map → Excel" Click="OnBtnClickMapToExcel" Margin="6,0"
                        ToolTip="Convert a shared Google My Maps link to an Excel sheet"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
