<Page x:Class="ntra_missions.RepeatersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:ntra_missions"
      mc:Ignorable="d"
      Title="RepeatersPage"
      Background="#F4F6FB">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="130"/>
            <RowDefinition Height="80"/>
            <RowDefinition/>
            <RowDefinition Height="90"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#000080" CornerRadius="18" Padding="18" BorderBrush="#122A7A" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="260"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Name="mainMenuGrid" Background="#D9DCEB" VerticalAlignment="Center" Width="64" Height="64" IsHitTestVisible="True" MouseEnter="MouseEnterMainMenu" MouseLeave="MouseLeaveMainMenu" ToolTip="Main Menu" MouseLeftButtonDown="OnClickMainMenu" Cursor="Hand" Margin="0,0,16,0">
                        <Grid.Clip>
                            <RectangleGeometry RadiusX="12" RadiusY="12" Rect="0,0,64,64"/>
                        </Grid.Clip>
                        <Image Name="menuItemImage" Source="Photos\tab_icon.png" Height="34" Width="34" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Grid>

                    <MenuItem Name="tabMenuButton" Visibility="Collapsed">
                        <MenuItem.ContextMenu>
                            <ContextMenu Closed="OnClosedMenuContectMenu">
                                <MenuItem Header="DashBoard" Name="dashboardMenuItem" Click="DashboardMenuSelection"/>
                                <MenuItem Header="Employees" Name="EmployeeMenuItem" Click="employeeMenuSelection"/>
                                <MenuItem Header="Companies" Name="CompanyMenuItem" Click="CompanyMenuSelection"/>
                                <MenuItem Header="Company Equipment" Name="CompanyEquipmentMenuItem" Click="CompanyEquipmentMenuSelection"/>
                                <MenuItem Header="Sites" Name="sitesMenuItem" Click="SitesMenuSelection"/>
                                <MenuItem Header="EMF" Name="emfMenuItem" Click="emfMenuSelection"/>
                                <MenuItem Header="Complaints" Name="ComplaintsMenuItem" Click="ComplaintsMenuSelection"/>
                                <MenuItem Header="Monitoring Missions" Name="monitoringMenuItem" Click="MonitoringMenuSelection"/>
                                <MenuItem Header="Repeaters" Name="repeatersMenuItem" IsChecked="True" IsHitTestVisible="False"/>
                                <MenuItem Header="Inspection Missions" Name="inspectionMenuItem" Click="InspectionMenuSelection"/>
                            </ContextMenu>
                        </MenuItem.ContextMenu>
                    </MenuItem>

                    <Image Source="Photos\NTRA_white1.png" Height="82" HorizontalAlignment="Left"/>
                </StackPanel>

                <Button Grid.Column="1" Name="changePasswordButton" Content="Change Password" VerticalAlignment="Bottom" FontWeight="Bold" Style="{StaticResource negativeButtonStyle}" Width="190" Height="44" Click="OnClickChangePasswordButton" Margin="0,0,0,6"/>

                <Border Grid.Column="2" Background="#1F2D8A" CornerRadius="12" Padding="12,8">
                    <Grid Name="userNameGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Name="userNameLabel" Foreground="White" FontSize="18" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Content="Username:"/>
                        <Button Grid.Row="1" Name="logoutButton" Content="Sign out" Style="{StaticResource buttonStyle}" Height="34" Width="130" HorizontalAlignment="Center" Background="LightGray" FontWeight="Bold" Foreground="#000080" Click="OnClickLogoutButton"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="White" CornerRadius="14" BorderBrush="#D9E0F2" BorderThickness="1" Padding="18,12" Margin="0,14,0,0">
            <DockPanel>
                <Label Style="{StaticResource headerLabelStyle}" Content="Repeaters" Foreground="#000080" HorizontalAlignment="Left" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                <Border Background="#EEF2FF" CornerRadius="10" Padding="14,8" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Manage, filter, and export repeaters efficiently" Foreground="#3E4A6B" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="14" BorderBrush="#D9E0F2" BorderThickness="1" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="60"/>
                            <RowDefinition Height="60"/>
                            <RowDefinition Height="60"/>
                            <RowDefinition Height="60"/>
                            <RowDefinition Height="60"/>
                            <RowDefinition Height="60"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Row="0" Grid.Column="0" Name="searchLatCheckBox" Content="Search &#10;Lat" Checked="OnCheckSearchLatCheckBox" Unchecked="OnUncheckSearchCheckBox" Style="{StaticResource checkBoxStyle}" Cursor="Hand"/>
                        <CheckBox Grid.Row="1" Grid.Column="0" Name="searchLongCheckBox" Content="Search &#10;Long" Checked="OnCheckSearchLongCheckBox" Unchecked="OnUncheckSearchLongCheckBox" Style="{StaticResource checkBoxStyle}" Cursor="Hand"/>
                        <CheckBox Grid.Row="2" Grid.Column="0" Name="cityCheckBox" Content="City" Checked="OnCheckCityCheckBox" Unchecked="OnUncheckCityCheckBox" Style="{StaticResource checkBoxStyle}" Cursor="Hand"/>
                        <CheckBox Grid.Row="3" Grid.Column="0" Name="areaCheckBox" Content="Area" Checked="OnCheckAreaCheckBox" Unchecked="OnUnCheckAreaCheckBox" Style="{StaticResource checkBoxStyle}" Cursor="Hand"/>
                        <CheckBox Grid.Row="4" Grid.Column="0" Name="statusCheckBox" Content="Status" Checked="OnCheckStatusCheckBox" Unchecked="OnUncheckStatusCheckBox" Style="{StaticResource checkBoxStyle}" Cursor="Hand"/>

                        <TextBox Grid.Row="0" Grid.Column="1" Name="latTextBox" TextChanged="OnTextChangedLatTextBox" Style="{StaticResource miniTextboxStyle}" IsEnabled="False"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Name="longTextBox" TextChanged="OnTextChangedLongTextBox" Style="{StaticResource miniTextboxStyle}" IsEnabled="False"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" Name="cityComboBox" SelectionChanged="OnSelChangedCityCombo" Style="{StaticResource miniComboBoxStyle}" IsEnabled="False"/>
                        <ComboBox Grid.Row="3" Grid.Column="1" Name="areaComboBox" SelectionChanged="OnSelChangedAreaCombo" Style="{StaticResource miniComboBoxStyle}" IsEnabled="False"/>
                        <ComboBox Grid.Row="4" Grid.Column="1" Name="statusComboBox" SelectionChanged="OnSelChangedStatusCombo" Style="{StaticResource miniComboBoxStyle}" IsEnabled="False"/>
                    </Grid>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="14" BorderBrush="#D9E0F2" BorderThickness="1" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="56"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="4,0">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Border Name="listViewBorder" CornerRadius="10,10,0,0" BorderThickness="2" BorderBrush="#000080" Background="White" Width="140" Height="44" MouseLeftButtonDown="OnClickListView" Margin="0,0,8,0">
                                <Label Style="{StaticResource mediumLabelStyle}" Content="List View" Foreground="#000080" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                            </Border>
                            <Border Name="tableViewBorder" CornerRadius="10,10,0,0" BorderThickness="2" BorderBrush="#000080" Background="#000080" Width="140" Height="44" MouseLeftButtonDown="OnClickTableView">
                                <Label Style="{StaticResource mediumLabelStyle}" Content="Table View" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>

                        <Border Background="#EEF2FF" CornerRadius="10" Padding="10,6" HorizontalAlignment="Right" DockPanel.Dock="Right">
                            <StackPanel Orientation="Horizontal">
                                <Label Style="{StaticResource wideLabelStyle}" Content="Repeaters Count:" VerticalAlignment="Center" Padding="4,0"/>
                                <Label Name="countLabel" Style="{StaticResource labelStyle}" VerticalAlignment="Center" Padding="4,0"/>
                            </StackPanel>
                        </Border>
                    </DockPanel>

                    <ListView Grid.Row="1"
                              Name="repeatersListView"
                              Background="White"
                              BorderThickness="0"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True"
                              Margin="0,6,0,0">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="{x:Type ListViewItem}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Margin" Value="0,8,0,0"/>
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="1" BorderBrush="#CFD7EE" Background="#FCFDFF" CornerRadius="10" Padding="12" Tag="{Binding RepeaterSerial}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="220"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding SerialText}" FontWeight="SemiBold" FontSize="15" Foreground="#1E2A4A"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CityText}" FontWeight="SemiBold" FontSize="15" Foreground="#1E2A4A"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding AreaText}" FontWeight="SemiBold" FontSize="15" Foreground="#1E2A4A"/>

                                        <Button Grid.Row="1" Grid.Column="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                HorizontalAlignment="Left"
                                                Foreground="#15327D"
                                                FontWeight="SemiBold"
                                                Tag="{Binding RepeaterSerial}"
                                                ToolTip="Left click to Copy coordinates!"
                                                Click="OnClickCopyCoordinates"
                                                Content="{Binding CoordinatesText}"/>

                                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding AddressText}" TextWrapping="Wrap" FontSize="13" Foreground="#43506F"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding CommentText}" TextWrapping="Wrap" FontSize="13" Foreground="#43506F"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding AddedByText}" FontSize="13" FontWeight="SemiBold" Foreground="#1E2A4A"/>

                                        <Border Grid.Row="0" Grid.Column="3"
                                                Grid.RowSpan="3"
                                                Width="200"
                                                Height="40"
                                                Margin="0,8,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource statusBorderStyle}">
                                                    <Setter Property="Background" Value="Green"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPending}" Value="True">
                                                            <Setter Property="Background" Value="Red"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Label Content="{Binding Status}"
                                                   Style="{StaticResource statusLabelStyle}"
                                                   Width="200"/>
                                        </Border>

                                        <Expander Grid.Row="3"
                                                  Grid.Column="0"
                                                  Grid.ColumnSpan="4"
                                                  Margin="0,12,0,0"
                                                  HorizontalAlignment="Left"
                                                  ExpandDirection="Down"
                                                  Expanded="OnExpandExpander">
                                            <Expander.Content>
                                                <Button Style="{StaticResource expanderButtonStyle}"
                                                        Content="Edit"
                                                        HorizontalContentAlignment="Center"
                                                        Click="OnClickEdit"/>
                                            </Expander.Content>
                                        </Expander>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <ScrollViewer Grid.Row="1" Name="tableViewScrollViewer" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" Margin="0,6,0,0">
                        <DataGrid Name="repeatersGrid" Background="White"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="White" CornerRadius="14" BorderBrush="#D9E0F2" BorderThickness="1" Padding="12" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource buttonStyle}" Content="Add" Click="OnBtnClickAdd" Margin="8,4"/>
                <Button Grid.Column="1" Style="{StaticResource buttonStyle}" Content="Export" Click="OnBtnClickExport" Margin="8,4"/>
                <Button Grid.Column="2" Style="{StaticResource buttonStyle}" Content="Excel Format" Click="OnBtnClickFormat" Margin="8,4"/>
                <Button Grid.Column="3" Style="{StaticResource buttonStyle}" Content="Re Import" Click="OnBtnClickReImport" Margin="8,4"/>
            </Grid>
        </Border>
    </Grid>
</Page>
