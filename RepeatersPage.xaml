<Page x:Class="ntra_missions.RepeatersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:ntra_missions"
      mc:Ignorable="d"
      Title="RepeatersPage"
      Background="#EEF2FA">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="136"/>
            <RowDefinition Height="96"/>
            <RowDefinition/>
            <RowDefinition Height="102"/>
        </Grid.RowDefinitions>

        <!-- Top application bar -->
        <Border Grid.Row="0" Background="#000080" CornerRadius="18" BorderBrush="#1D2E8A" BorderThickness="1" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource MenuButtonSurfaceStyle}">
                        <Grid Name="mainMenuGrid"
                              Cursor="Hand"
                              ToolTip="Main Menu"
                              MouseEnter="MouseEnterMainMenu"
                              MouseLeave="MouseLeaveMainMenu"
                              MouseLeftButtonDown="OnClickMainMenu">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Rectangle Width="24" Height="3" RadiusX="2" RadiusY="2" Fill="#000080" Margin="0,2"/>
                                <Rectangle Width="24" Height="3" RadiusX="2" RadiusY="2" Fill="#000080" Margin="0,2"/>
                                <Rectangle Width="24" Height="3" RadiusX="2" RadiusY="2" Fill="#000080" Margin="0,2"/>
                            </StackPanel>
                            <Image Name="menuItemImage" Source="Photos\tab_icon.png" Height="1" Width="1" Opacity="0"/>
                        </Grid>
                    </Border>

                    <MenuItem Name="tabMenuButton" Visibility="Collapsed">
                        <MenuItem.ContextMenu>
                            <ContextMenu Closed="OnClosedMenuContectMenu">
                                <MenuItem Header="DashBoard" Name="dashboardMenuItem" Click="DashboardMenuSelection"/>
                                <MenuItem Header="Employees" Name="EmployeeMenuItem" Click="employeeMenuSelection"/>
                                <MenuItem Header="Companies" Name="CompanyMenuItem" Click="CompanyMenuSelection"/>
                                <MenuItem Header="Company Equipment" Name="CompanyEquipmentMenuItem" Click="CompanyEquipmentMenuSelection"/>
                                <MenuItem Header="Sites" Name="sitesMenuItem" Click="SitesMenuSelection"/>
                                <MenuItem Header="EMF" Name="emfMenuItem" Click="emfMenuSelection"/>
                                <MenuItem Header="Complaints" Name="ComplaintsMenuItem" Click="ComplaintsMenuSelection"/>
                                <MenuItem Header="Monitoring Missions" Name="monitoringMenuItem" Click="MonitoringMenuSelection"/>
                                <MenuItem Header="Repeaters" Name="repeatersMenuItem" IsChecked="True" IsHitTestVisible="False"/>
                                <MenuItem Header="Inspection Missions" Name="inspectionMenuItem" Click="InspectionMenuSelection"/>
                            </ContextMenu>
                        </MenuItem.ContextMenu>
                    </MenuItem>

                    <StackPanel VerticalAlignment="Center">
                        <Image Source="Photos\NTRA_white1.png" Height="72"/>
                        <TextBlock Text="Spectrum Monitoring Workspace"
                                   Margin="4,2,0,0"
                                   Foreground="#DBE3FF"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1"
                        Name="changePasswordButton"
                        Content="Change Password"
                        Style="{StaticResource HeaderActionButtonStyle}"
                        Width="196"
                        VerticalAlignment="Center"
                        Click="OnClickChangePasswordButton"/>

                <Border Grid.Column="2" Background="#1D2C89" CornerRadius="12" Padding="12,12">
                    <Grid Name="userNameGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0"
                               Name="userNameLabel"
                               Content="Username:"
                               Foreground="White"
                               FontSize="18"
                               HorizontalContentAlignment="Center"
                               VerticalContentAlignment="Center"/>
                        <Button Grid.Row="1"
                                Name="logoutButton"
                                Content="Sign out"
                                Style="{StaticResource HeaderActionButtonStyle}"
                                Width="140"
                                Height="34"
                                Margin="0,6,0,0"
                                HorizontalAlignment="Center"
                                Background="#F8FAFF"
                                Click="OnClickLogoutButton"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Page heading -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,14,0,0" Padding="18,10">
            <DockPanel LastChildFill="False" VerticalAlignment="Center">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Repeaters" FontSize="30" FontWeight="Bold" Foreground="#000080"/>
                    <TextBlock Text="Filter, review, and export repeaters with a cleaner workflow"
                               FontSize="13"
                               Foreground="#4A5779"/>
                </StackPanel>

                <Border DockPanel.Dock="Right" Style="{StaticResource SmallBadgeStyle}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Live data + same business logic"
                                   Foreground="#274183"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Filters -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <TextBlock Text="Filters" FontSize="18" FontWeight="Bold" Foreground="#000080"/>
                            <TextBlock Text="Choose criteria"
                                       Margin="8,5,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="#6A7696"
                                       FontSize="12"/>
                        </StackPanel>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Grid Margin="0,6,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="64"/>
                                <RowDefinition Height="64"/>
                                <RowDefinition Height="64"/>
                                <RowDefinition Height="64"/>
                                <RowDefinition Height="64"/>
                                <RowDefinition Height="64"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Row="0" Grid.Column="0" Name="searchLatCheckBox" Content="Search &#10;Lat" Checked="OnCheckSearchLatCheckBox" Unchecked="OnUncheckSearchCheckBox" Style="{StaticResource FilterItemLabelStyle}" Cursor="Hand"/>
                            <CheckBox Grid.Row="1" Grid.Column="0" Name="searchLongCheckBox" Content="Search &#10;Long" Checked="OnCheckSearchLongCheckBox" Unchecked="OnUncheckSearchLongCheckBox" Style="{StaticResource FilterItemLabelStyle}" Cursor="Hand"/>
                            <CheckBox Grid.Row="2" Grid.Column="0" Name="cityCheckBox" Content="City" Checked="OnCheckCityCheckBox" Unchecked="OnUncheckCityCheckBox" Style="{StaticResource FilterItemLabelStyle}" Cursor="Hand"/>
                            <CheckBox Grid.Row="3" Grid.Column="0" Name="areaCheckBox" Content="Area" Checked="OnCheckAreaCheckBox" Unchecked="OnUnCheckAreaCheckBox" Style="{StaticResource FilterItemLabelStyle}" Cursor="Hand"/>
                            <CheckBox Grid.Row="4" Grid.Column="0" Name="statusCheckBox" Content="Status" Checked="OnCheckStatusCheckBox" Unchecked="OnUncheckStatusCheckBox" Style="{StaticResource FilterItemLabelStyle}" Cursor="Hand"/>

                            <TextBox Grid.Row="0" Grid.Column="1" Name="latTextBox" TextChanged="OnTextChangedLatTextBox" Style="{StaticResource miniTextboxStyle}" IsEnabled="False" Margin="0,10,0,10"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Name="longTextBox" TextChanged="OnTextChangedLongTextBox" Style="{StaticResource miniTextboxStyle}" IsEnabled="False" Margin="0,10,0,10"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" Name="cityComboBox" SelectionChanged="OnSelChangedCityCombo" Style="{StaticResource FilterComboBoxStyle}" IsEnabled="False" Margin="0,10,0,10"/>
                            <ComboBox Grid.Row="3" Grid.Column="1" Name="areaComboBox" SelectionChanged="OnSelChangedAreaCombo" Style="{StaticResource FilterComboBoxStyle}" IsEnabled="False" Margin="0,10,0,10"/>
                            <ComboBox Grid.Row="4" Grid.Column="1" Name="statusComboBox" SelectionChanged="OnSelChangedStatusCombo" Style="{StaticResource FilterComboBoxStyle}" IsEnabled="False" Margin="0,10,0,10"/>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Results -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <Border Name="listViewBorder" CornerRadius="10,10,0,0" BorderThickness="2" BorderBrush="#000080" Background="White" Width="150" Height="42" MouseLeftButtonDown="OnClickListView" Margin="0,0,8,0">
                                <Label Style="{StaticResource mediumLabelStyle}" Content="List View" Foreground="#000080" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                            </Border>
                            <Border Name="tableViewBorder" CornerRadius="10,10,0,0" BorderThickness="2" BorderBrush="#000080" Background="#000080" Width="150" Height="42" MouseLeftButtonDown="OnClickTableView">
                                <Label Style="{StaticResource mediumLabelStyle}" Content="Table View" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>

                        <Border DockPanel.Dock="Right" Style="{StaticResource SmallBadgeStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Label Style="{StaticResource wideLabelStyle}" Content="Repeaters Count:" Padding="3,0"/>
                                <Label Name="countLabel" Style="{StaticResource labelStyle}" Padding="3,0"/>
                            </StackPanel>
                        </Border>
                    </DockPanel>

                    <ListView Grid.Row="1"
                              Name="repeatersListView"
                              Background="White"
                              BorderThickness="0"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="{x:Type ListViewItem}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Margin" Value="0,8,0,0"/>
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="1" BorderBrush="#CFD8EF" Background="#FBFCFF" CornerRadius="12" Padding="12" Tag="{Binding RepeaterSerial}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="220"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding SerialText}" FontWeight="SemiBold" FontSize="15" Foreground="#1D2A4E"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CityText}" FontWeight="SemiBold" FontSize="15" Foreground="#1D2A4E"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding AreaText}" FontWeight="SemiBold" FontSize="15" Foreground="#1D2A4E"/>

                                        <Button Grid.Row="1"
                                                Grid.Column="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                HorizontalAlignment="Left"
                                                Foreground="#143381"
                                                FontWeight="SemiBold"
                                                Tag="{Binding RepeaterSerial}"
                                                ToolTip="Left click to Copy coordinates!"
                                                Click="OnClickCopyCoordinates"
                                                Content="{Binding CoordinatesText}"/>

                                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding AddressText}" TextWrapping="Wrap" FontSize="13" Foreground="#435172"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding CommentText}" TextWrapping="Wrap" FontSize="13" Foreground="#435172"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding AddedByText}" FontSize="13" FontWeight="SemiBold" Foreground="#1D2A4E"/>

                                        <Border Grid.Row="0" Grid.Column="3" Grid.RowSpan="3" Width="200" Height="40" Margin="0,8,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource statusBorderStyle}">
                                                    <Setter Property="Background" Value="Green"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPending}" Value="True">
                                                            <Setter Property="Background" Value="Red"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Label Content="{Binding Status}" Style="{StaticResource statusLabelStyle}" Width="200"/>
                                        </Border>

                                        <Expander Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,12,0,0" HorizontalAlignment="Left" ExpandDirection="Down" Expanded="OnExpandExpander">
                                            <Expander.Content>
                                                <Button Style="{StaticResource expanderButtonStyle}" Content="Edit" HorizontalContentAlignment="Center" Click="OnClickEdit"/>
                                            </Expander.Content>
                                        </Expander>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <ScrollViewer Grid.Row="1" Name="tableViewScrollViewer" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" Background="White">
                        <DataGrid Name="repeatersGrid" Background="White"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer actions -->
        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Margin="0,14,0,0" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource FooterActionButtonStyle}" Content="Add" Click="OnBtnClickAdd" Margin="8,6"/>
                <Button Grid.Column="1" Style="{StaticResource FooterActionButtonStyle}" Content="Export" Click="OnBtnClickExport" Margin="8,6"/>
                <Button Grid.Column="2" Style="{StaticResource FooterActionButtonStyle}" Content="Excel Format" Click="OnBtnClickFormat" Margin="8,6"/>
                <Button Grid.Column="3" Style="{StaticResource FooterActionButtonStyle}" Content="Re Import" Click="OnBtnClickReImport" Margin="8,6"/>
            </Grid>
        </Border>
    </Grid>
</Page>
