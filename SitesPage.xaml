<Page x:Class="ntra_missions.SitesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ntra_missions"
      mc:Ignorable="d" 
      Title="Sites">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="150"/>
            <RowDefinition Height="100"/>
            <RowDefinition/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#000080">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <WrapPanel>
                <Grid Name="mainMenuGrid" Background="LightGray" VerticalAlignment="Stretch" Width="70" IsHitTestVisible="True" MouseEnter="MouseEnterMainMenu" MouseLeave="MouseLeaveMainMenu" ToolTip="Main Menu" MouseLeftButtonDown="OnClickMainMenu" Cursor="Hand">
                    <Image Name="menuItemImage" Source="Photos\tab_icon.png" Height="50" Width="50" />
                </Grid>

                <MenuItem Name="tabMenuButton" Visibility="Collapsed">
                    <MenuItem.ContextMenu>
                        <ContextMenu Closed="OnClosedMenuContectMenu">
                            <MenuItem Header="DashBoard" Name="dashboardMenuItem" Click="DashboardMenuSelection"/>
                            <MenuItem Header="Employees" Name="EmployeeMenuItem" Click="employeeMenuSelection"/>
                            <MenuItem Header="Companies" Name="CompanyMenuItem" Click="CompanyMenuSelection"/>
                            <MenuItem Header="Company Equipment" Name="CompanyEquipmentMenuItem" Click="CompanyEquipmentMenuSelection"/>
                            <MenuItem Header="Sites" Name="SitesMenuItem" IsChecked="True" IsHitTestVisible="False"/>
                            <MenuItem Header="EMF" Name="emfMenuItem" Click="emfMenuSelection"/>
                            <MenuItem Header="Complaints" Name="ComplaintsMenuItem" Click="ComplaintsMenuSelection"/>
                            <MenuItem Header="Monitoring Missions" Name="monitoringMenuItem" Click="MonitoringMenuSelection"/>
                            <MenuItem Header="Inspection Missions" Name="InspectionMenuItem" Click="InspectionMenuSelection"/>
                            
                        </ContextMenu>
                    </MenuItem.ContextMenu>
                </MenuItem>

                <Image Source="Photos\NTRA_white1.png" VerticalAlignment="Center" Height="200"  HorizontalAlignment="Left"/>
            </WrapPanel>

            <Grid Name="userNameGrid" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Name="userNameLabel" Foreground="White" FontSize="20" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Content="Username:"/>
                <Button Grid.Row="1" Name="logoutButton" Content="Sign out" Style="{StaticResource buttonStyle}" VerticalAlignment="Bottom" Background="LightGray" FontWeight="Bold" Foreground="#000080" Click="OnClickLogoutButton"/>
            </Grid>

            <Button Grid.Column="1" Name="changePasswordButton" Content="Change Password" VerticalAlignment="Bottom" FontWeight="Bold" Style="{StaticResource negativeButtonStyle}" Width="200" Click="OnClickChangePasswordButton"/>

        </Grid>

        <!--<ScrollViewer Grid.Row="1">
        <WebBrowser  x:Name="wbMaps" Source="https://www.google.com/maps" GotTouchCapture="wbMaps_GotTouchCapture" Navigated="wbMaps_Navigated" Navigating="wbMaps_Navigating"/>
        </ScrollViewer>-->

        <Label Name="titleLabel" Grid.Row="1" Style="{StaticResource headerLabelStyle}" Content="Sites" HorizontalAlignment="Center" Foreground="#000080"/>


        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="24">
                <Grid >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="70"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Row="0" Grid.Column="0" Name="searchCheckBox" Content="Search"  Style="{StaticResource checkBoxStyle}" Checked="OnCheckSearchCheckbox" Unchecked="OnUncheckSearchCheckbox" ToolTip="Search by site number and region"/>
                    <CheckBox Grid.Row="1" Grid.Column="0" Name="companyCheckBox" Content="Company" Style="{StaticResource checkBoxStyle}" Checked="OnCheckCompanyCheckbox" Unchecked="OnUncheckCompanyCheckbox"/>
                    <CheckBox Grid.Row="2" Grid.Column="0" Name="cityCheckBox" Content="City" Style="{StaticResource checkBoxStyle}" Checked="OnCheckCityCheckbox" Unchecked="OnUncheckCityCheckbox"/>
                    <CheckBox Grid.Row="3" Grid.Column="0" Name="addedByCheckBox" Content="Added by" Style="{StaticResource checkBoxStyle}" Checked="OnCheckAddedByCheckbox" Unchecked="OnUncheckAddedByCheckBox"/>
                    <CheckBox Grid.Row="4" Grid.Column="0" Name="longCheckBox" Content="Long" Style="{StaticResource checkBoxStyle}" Checked="OnCheckLongCheckbox" Unchecked="OnUncheckLongCheckBox"/>
                    <CheckBox Grid.Row="5" Grid.Column="0" Name="latCheckBox" Content="Lat" Style="{StaticResource checkBoxStyle}" Checked="OnCheckLatCheckbox" Unchecked="OnUncheckLatCheckBox"/>


                    <TextBox Grid.Row="0" Grid.Column="1" Name="searchTextBox"  Style="{StaticResource miniTextboxStyle}" IsEnabled='False' TextChanged="OnTextChangedSearchTextbox" ToolTip="Search by site number and region"/>
                    <ComboBox Grid.Row="1" Grid.Column="1" Name="companyComboBox" Style="{StaticResource miniComboBoxStyle}" IsEnabled='False' SelectionChanged="OnSelChangedCompanyCombo"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" Name="cityComboBox" Style="{StaticResource miniComboBoxStyle}" IsEnabled='False' SelectionChanged="OnSelChangedCityCombo"/>
                    <ComboBox Grid.Row="3" Grid.Column="1" Name="addedByComboBox" Style="{StaticResource miniComboBoxStyle}" IsEnabled='False' SelectionChanged="OnSelChangedAddedByCombo"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Name="longTextBox" Style="{StaticResource miniTextboxStyle}" IsEnabled='False' TextChanged="OnTextChangedLongTextBox"/>
                    <TextBox Grid.Row="5" Grid.Column="1" Name="latTextBox" Style="{StaticResource miniTextboxStyle}" IsEnabled='False' TextChanged="OnTextChangedLatTextBox"/>

                </Grid>
            </ScrollViewer>
            
            <Grid Grid.Column="1" Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Border Name="listViewBorder" CornerRadius="0,30,0,0" BorderThickness="3" BorderBrush="#000080" Background="White" Width="150" MouseLeftButtonDown="OnClickListView">
                        <Label Style="{StaticResource mediumLabelStyle}" Content="List View" Foreground="#000080" HorizontalAlignment="Left" FontWeight="Bold"/>
                    </Border>
                    <Border Name="tableViewBorder" CornerRadius="0,30,0,0" BorderThickness="3" BorderBrush="#000080" Background="#000080" Width="150" MouseLeftButtonDown="OnClickTableView">
                        <Label Style="{StaticResource mediumLabelStyle}" Content="Table View" Foreground="White" HorizontalAlignment="Left" FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="0" HorizontalAlignment="Right" Orientation="Horizontal">
                    <Label  Style="{StaticResource labelStyle}" Content="Sites Count: "/>
                    <Label Name="countLabel" Style="{StaticResource labelStyle}" />
                </StackPanel>
                
                <ScrollViewer Grid.Row="1" Name="listViewScrollViewer" VerticalContentAlignment="Stretch" >
                    <StackPanel Name="sitesStackPanel" Background="White"/>
                </ScrollViewer>
                <ScrollViewer Grid.Row="1" Name="tableViewScrollViewer"  Visibility="Collapsed" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden">
                    <DataGrid Name="sitesGrid" BorderBrush="#000080"  ColumnHeaderHeight="50"  Foreground="#000080" FontWeight="Bold" FontSize="18" AlternatingRowBackground="LightGray"  CanUserSortColumns="False" CanUserReorderColumns="False" IsTextSearchEnabled="True" CopyingRowClipboardContent="OnCopyDataGrid" IsReadOnly="True" IsManipulationEnabled="True"  Height="600" Background="White" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible"/>

                </ScrollViewer>
            </Grid>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>


            <Button  Style="{StaticResource buttonStyle}" Content="Add" Click="OnBtnClickAdd"/>
            <Button Grid.Column="1" Style="{StaticResource buttonStyle}" Content="Import" Click="OnBtnClickImport"/>
            <Button Grid.Column="2" Style="{StaticResource buttonStyle}" Content="Export" Click="OnBtnClickExport"/>
            
        </Grid>
    </Grid>
</Page>
