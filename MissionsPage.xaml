<Page x:Class="ntra_missions.MissionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ntra_missions"
      mc:Ignorable="d" 
      Title="MissionsPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="150"/>
            <RowDefinition Height="100"/>
            <RowDefinition/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#000080">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <WrapPanel>
                <Grid Name="mainMenuGrid" Background="LightGray" VerticalAlignment="Stretch" Width="70" IsHitTestVisible="True" MouseEnter="MouseEnterMainMenu" MouseLeave="MouseLeaveMainMenu" ToolTip="Main Menu" MouseLeftButtonDown="OnClickMainMenu" Cursor="Hand">
                    <Image Name="menuItemImage" Source="Photos\tab_icon.png" Height="50" Width="50"/>
                </Grid>

                <MenuItem Name="tabMenuButton" Visibility="Collapsed">
                    <MenuItem.ContextMenu>
                        <ContextMenu Closed="OnClosedMenuContectMenu">
                            <MenuItem Header="DashBoard" Name="dashboardMenuItem" Click="DashboardMenuSelection"/>
                            <MenuItem Header="Employees" Name="EmployeeMenuItem" Click="employeeMenuSelection"/>
                            <MenuItem Header="Companies" Name="CompanyMenuItem" Click="CompanyMenuSelection"/>
                            <MenuItem Header="Company Equipment" Name="CompanyEquipmentMenuItem" Click="CompanyEquipmentMenuSelection"/>
                            <MenuItem Header="Sites" Name="sitesMenuItem" Click="SitesMenuSelection"/>
                            <MenuItem Header="EMF" Name="emfMenuItem" Click="emfMenuSelection"/>
                            <MenuItem Header="Complaints" Name="ComplaintsMenuItem" Click="ComplaintsMenuSelection"/>
                            <MenuItem Header="Monitoring Missions" Name="monitoringMenuItem" IsChecked="True" IsHitTestVisible="False"/>
                            <MenuItem Header="Inspection Missions" Name="inspectionMenuItem" Click="InspectionMenuSelection"/>
                        </ContextMenu>
                    </MenuItem.ContextMenu>
                </MenuItem>
                
                <Image Source="Photos\NTRA_white1.png" VerticalAlignment="Center" Height="200"  HorizontalAlignment="Left"/>
            </WrapPanel>

            <Grid Name="userNameGrid" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Name="userNameLabel" Foreground="White" FontSize="20" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Content="Username:"/>
                <Button Grid.Row="1" Name="logoutButton" Content="Sign out" Style="{StaticResource buttonStyle}" VerticalAlignment="Bottom" Background="LightGray" FontWeight="Bold" Foreground="#000080" Click="OnClickLogoutButton"/>
            </Grid>

            <Button Grid.Column="1" Name="changePasswordButton" Content="Change Password" VerticalAlignment="Bottom" FontWeight="Bold" Style="{StaticResource negativeButtonStyle}" Width="200" Click="OnClickChangePasswordButton"/>

        </Grid>

        <!--<ScrollViewer Grid.Row="1">
        <WebBrowser  x:Name="wbMaps" Source="https://www.google.com/maps" GotTouchCapture="wbMaps_GotTouchCapture" Navigated="wbMaps_Navigated" Navigating="wbMaps_Navigating"/>
        </ScrollViewer>-->

        <Label Grid.Row="1" Style="{StaticResource headerLabelStyle}" Content="Monitoring Missions" HorizontalAlignment="Center" Foreground="#000080"/>


        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="70"/>
                    <RowDefinition Height="70"/>
                    <RowDefinition Height="70"/>
                    <RowDefinition Height="70"/>
                    <RowDefinition Height="70"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Row="0" Grid.Column="0" Name="searchCheckBox" Content="Search" Checked="OnCheckSearchCheckBox" Unchecked="OnUncheckSearchCheckBox" Style="{StaticResource checkBoxStyle}" ToolTip="Search site"/>
                <CheckBox Grid.Row="1" Grid.Column="0" Name="yearCheckBox" Content="Year" Checked="OnCheckYearCheckBox" Unchecked="OnUncheckYearCheckBox" Style="{StaticResource checkBoxStyle}"/>
                <CheckBox Grid.Row="2" Grid.Column="0" Name="monthCheckBox" Content="Month" Checked="OnCheckMonthCheckBox" Unchecked="OnUncheckMonthCheckBox" Style="{StaticResource checkBoxStyle}"/>
                <CheckBox Grid.Row="3" Grid.Column="0" Name="employeeCheckBox" Content="Engineer" Checked="OnCheckEmployeeCheckBox" Unchecked="OnUncheckEmployeeCheckBox" Style="{StaticResource checkBoxStyle}"/>
                <CheckBox Grid.Row="4" Grid.Column="0" Name="serviceProviderCheckBox" Content="Service &#10;provider" Checked="OnCheckServiceProviderCheckBox" Unchecked="OnUncheckServiceProviderCheckBox" Style="{StaticResource checkBoxStyle}"/>


                <TextBox Grid.Row="0" Grid.Column="1" Name="searchTextBox" TextChanged="OnTextChangedSearchTextBox" Style="{StaticResource miniTextboxStyle}" IsEnabled='False' ToolTip="Search site"/>
                <ComboBox Grid.Row="1" Grid.Column="1" Name="yearComboBox" SelectionChanged="OnSelChangedYearCombo" Style="{StaticResource miniComboBoxStyle}" IsEnabled='False'/>
                <ComboBox Grid.Row="2" Grid.Column="1" Name="monthComboBox" SelectionChanged="OnSelChangedMonthCombo" Style="{StaticResource miniComboBoxStyle}" IsEnabled='False'/>
                <ComboBox Grid.Row="3" Grid.Column="1" Name="employeeComboBox" SelectionChanged="OnSelChangedEmployeeCombo" Style="{StaticResource miniComboBoxStyle}" IsEnabled='False'/>
                <ComboBox Grid.Row="4" Grid.Column="1" Name="serviceProviderComboBox" SelectionChanged="OnSelChangedServiceProviderCombo" Style="{StaticResource miniComboBoxStyle}" IsEnabled='False'/>

            </Grid>

            <ScrollViewer Grid.Column="1" MinHeight="400" >
                <StackPanel Name="missionsStackPanel" Background="White"/>
            </ScrollViewer>

        </Grid>

        <Button Grid.Row="3" Style="{StaticResource buttonStyle}" Content="Add" Click="OnBtnClickAdd"/>


    </Grid>
</Page>
