<Window x:Class="ntra_missions.ComplaintsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ntra_missions"
        mc:Ignorable="d"
        Title="Complaints Window" Height="800" Width="800" ResizeMode="NoResize" Background="LightGray" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition />
            <RowDefinition Height="75"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#000080">
            <Image Source="Photos\NTRA_white1.png" VerticalAlignment="Center" Height="200"  HorizontalAlignment="Left"/>
            <Label Name="headerLabel" Content="Complaint" Style="{StaticResource headerLabelStyle}" HorizontalAlignment="Center"/>
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="24">
            <Grid Name="mainGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="80"/>
                    <RowDefinition />
                </Grid.RowDefinitions>


                <WrapPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Label Content="Company &#10;Name: " Style="{StaticResource labelStyleBlack}" />
                    <ComboBox Name="companyNameComboBox" Style="{StaticResource comboBoxStyle}" Margin="12,0,0,0" SelectionChanged="OnSelChangedCompanyNameCombo"/>
                </WrapPanel>
                
                <WrapPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Label Content="Date: " Style="{StaticResource labelStyleBlack}"/>
                    <DatePicker Name="dateAddedDatePicker" Style="{StaticResource datePickerStyle}" Margin="12,0,0,0" IsTodayHighlighted="True"/>
                </WrapPanel>

                <WrapPanel Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Label Content="Ticket &#10;Number: " Style="{StaticResource labelStyleBlack}"/>
                    <TextBox Name="ticketNumberTextBox" Style="{StaticResource textboxStyle}" Margin="12,0,0,0" PreviewTextInput="NumberValidationTextBox"/>
                </WrapPanel>


                <WrapPanel Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Label Content="Status: " Style="{StaticResource labelStyleBlack}"/>
                    <ComboBox Name="statusComboBox" Style="{StaticResource comboBoxStyle}" Margin="12,0,0,0" IsEnabled="False"/>
                </WrapPanel>


                <Border Name="filtersBorder" Grid.Row="0" Grid.ColumnSpan="2" BorderThickness="3" BorderBrush="#000080" CornerRadius="20" Margin="12">
                    <StackPanel Name="filtersStackPanel" >

                        <WrapPanel Name="searchWrapPanel" Grid.Row="2" Grid.ColumnSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBox Name="searchTextBox" Style="{StaticResource wideTextboxStyle}" ToolTip="Search Site Number"/>
                            <Button Name="searchButton" Content="Search" Style="{StaticResource negativeButtonStyle}" Click="OnButtonClickSearch"/>
                            <Button Name="undoSearchButton" Content="Cancel" Style="{StaticResource negativeButtonStyle}" Foreground="Red" Click="OnButtonClickCancel"/>
                        </WrapPanel>

                        <CheckBox Name="filtersCheckBox" Content="Apply Filter" Style="{StaticResource headerCheckBoxStyle}" Checked="OnCheckShowFilters" Unchecked="OnUnCheckShowFilters"/>

                        <Grid Name="filtersGrid" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <WrapPanel Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center">
                                <Label Content="City: " Style="{StaticResource labelStyleBlack}"/>
                                <ComboBox Name="filterCityCombo" Style="{StaticResource miniComboBoxStyle}" />
                            </WrapPanel>

                            <WrapPanel Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center">
                                <Label Content="Region: " Style="{StaticResource labelStyleBlack}"/>
                                <TextBox Name="filterRegionTextBox" Style="{StaticResource miniTextboxStyle}" />
                            </WrapPanel>

                            <WrapPanel Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center">
                                <Label Content="Status: " Style="{StaticResource labelStyleBlack}"/>
                                <ComboBox Name="filterStatusComboBox" Style="{StaticResource miniComboBoxStyle}"/>
                            </WrapPanel>

                            <WrapPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center">
                                <Label Content="Long, Lat:" Style="{StaticResource labelStyleBlack}"/>
                                <TextBox Name="filterLongTextBox" Style="{StaticResource miniTextboxStyle}" />
                                <TextBox Name="filterLatTextBox" Style="{StaticResource miniTextboxStyle}" />
                            </WrapPanel>

                            <WrapPanel Grid.Row="2" Grid.ColumnSpan="2" HorizontalAlignment="Center">
                                <Button Content="Apply" Style="{StaticResource negativeButtonStyle}" Name="applyFiltersButton" Click="OnClickApplyFiltersButton"/>
                                <Button Content="Reset" Style="{StaticResource negativeButtonStyle}" Foreground="Red" Name="removeFiltersButton" Click="OnClickRemoveFiltersButton"/>
                            </WrapPanel>
                        </Grid>

                    </StackPanel>
                </Border>

                <Grid Grid.Row="3" Grid.ColumnSpan="2" Name="sitesGrid" >

                    <Grid.RowDefinitions>
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    
                    <Border BorderThickness="3" BorderBrush="#000080" CornerRadius="20" Margin="12" Name="firstSiteBorder" VerticalAlignment="Top">
                        <Grid Name="firstSiteGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="50"/>
                                <RowDefinition Height="50"/>
                                <RowDefinition />
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0" Grid.ColumnSpan="2" Content="Site" HorizontalAlignment="Center" HorizontalContentAlignment="Center" Style="{StaticResource headerLabelStyle}" Width="300" Background="#000080" FontSize="20" FontWeight="Bold"/>

                            <WrapPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Label Content="Site No: " Style="{StaticResource labelStyleBlack}"/>
                                <ComboBox Name="siteNumberComboBox" Style="{StaticResource comboBoxStyle}" Margin="12,0,0,0" IsEditable="True" IsTextSearchEnabled="True" IsTextSearchCaseSensitive="False" IsEnabled="False" SelectionChanged="OnSelChangedSiteNumberCombo"/>
                            </WrapPanel>

                            <WrapPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Label Content="Status: " Style="{StaticResource labelStyleBlack}"/>
                                <ComboBox Name="siteStatusComboBox" Style="{StaticResource comboBoxStyle}" Margin="12,0,0,0" IsEnabled="False"/>
                            </WrapPanel>
                            
                            <WrapPanel Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Label Content="City: " Style="{StaticResource labelStyleBlack}"/>
                                <ComboBox Name="regionComboBox" Style="{StaticResource comboBoxStyle}" SelectionChanged="OnSelChangedRegionComboBox" Margin="12,0,0,0"/>
                            </WrapPanel>

                            <WrapPanel Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Label Content="Region: " Style="{StaticResource labelStyleBlack}"/>
                                <TextBox Name="regionTextBox" Style="{StaticResource textboxStyle}" Margin="12,0,0,0"/>
                            </WrapPanel>


                            <WrapPanel Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Label Content="Long: " Style="{StaticResource labelStyleBlack}"/>
                                <TextBox Name="longTextBox" Style="{StaticResource textboxStyle}" Margin="12,0,0,0" PreviewTextInput="NumberValidationTextBox"/>
                            </WrapPanel>

                            <WrapPanel Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Label Content="Lat: " Style="{StaticResource labelStyleBlack}"/>
                                <TextBox Name="latTextBox" Style="{StaticResource textboxStyle}" Margin="12,0,0,0" PreviewTextInput="NumberValidationTextBox"/>
                            </WrapPanel>

                            <Grid Grid.Row="4" Grid.ColumnSpan="2" Margin="12" Name="sector1Grid">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="50"/>
                                    <RowDefinition Height="50"/>
                                    <RowDefinition Height="50"/>
                                    <RowDefinition Height="50"/>
                                    <RowDefinition Height="50"/>
                                    <RowDefinition Height="30"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>

                                <WrapPanel  Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" >
                                    <Label Content="Sector No: " Style="{StaticResource mediumLabelStyleBlack}"/>
                                    <TextBox Style="{StaticResource miniTextboxStyle}" Margin="12,0,0,0"/>
                                </WrapPanel>

                                <WrapPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" >
                                    <Label Content="RRU: " Style="{StaticResource mediumLabelStyleBlack}"/>
                                    <ComboBox Name="rruComboBox" Style="{StaticResource miniComboBoxStyle}" Margin="12,0,0,0" />
                                </WrapPanel>

                                <WrapPanel Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" >
                                    <Label Content="Shared: " Style="{StaticResource mediumLabelStyleBlack}"/>
                                    <ComboBox Name="sharedComboBox" Style="{StaticResource miniComboBoxStyle}" Margin="12,0,0,0" />
                                </WrapPanel>

                                <WrapPanel Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" >
                                    <Label Content="Azimuth: " Style="{StaticResource mediumLabelStyleBlack}"/>
                                    <TextBox Name="azimuthTextBox" Style="{StaticResource miniTextboxStyle}" Margin="12,0,0,0" />
                                </WrapPanel>
                                
                                <WrapPanel Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" >
                                    <Label Content="RTWP: " Style="{StaticResource mediumLabelStyleBlack}"/>
                                    <TextBox Name="rtwpTextBox" Style="{StaticResource miniTextboxStyle}" Margin="12,0,0,0" />
                                </WrapPanel>


                                <Label Grid.Row="0" Grid.Column="1" Content="Sector Bands" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#000080" FontSize="20"  Style="{StaticResource headerLabelStyle}"/>

                                <ScrollViewer Grid.Row="1" Grid.RowSpan="3" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalAlignment="Center" Height="80" VerticalAlignment="Top">
                                    <Grid Name="sector1BandsGrid" HorizontalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                    </Grid>
                                </ScrollViewer>

                                <Image Name="addSectorIcon" Grid.Row="5" Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center" Source="\Photos\plus_icon.png" Height="30" Width="30" ToolTip="Add Sector" MouseLeftButtonDown="OnClickAddSector"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="2" Name="buttonsGrid" Margin="24,0,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Name="addSiteButton" Content="Add Site" Style="{StaticResource buttonStyle}" Click="OnBtnClickAddSite"/>
            <Button Grid.Column="1" Name="finishButton" Content="Save Changes" Style="{StaticResource buttonStyle}" Click='OnButtonClickSaveChanges'/>
        </Grid>
    </Grid>
</Window>
