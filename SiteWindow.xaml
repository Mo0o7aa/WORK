<Window x:Class="ntra_missions.SiteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ntra_missions"
        mc:Ignorable="d"
        Title="Site Window" Height="600" Width="800" Background="LightGray">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition/>
            <RowDefinition Height="75"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource navyblue}">
            <Image Source="Photos\NTRA_white1.png" VerticalAlignment="Center" Height="200"  HorizontalAlignment="Left"/>
            <Label Name="headerLabel" Content="SITE" Style="{StaticResource headerLabelStyle}" HorizontalAlignment="Center"/>
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="24">
            <Grid Name="mainGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>


                <WrapPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Label Content="Company &#10;Name: " Style="{StaticResource labelStyleBlack}" />
                    <ComboBox Name="companyNameComboBox" Style="{StaticResource comboBoxStyle}" Margin="12,0,0,0" SelectionChanged="OnSelChangedCompanyNameCombo"/>
                </WrapPanel>

                <WrapPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Label Content="Site &#10;Number: " Style="{StaticResource labelStyleBlack}"/>
                    <TextBox Name="siteNumberTextBox" Style="{StaticResource textboxStyle}" Margin="12,0,0,0" />
                </WrapPanel>


                <WrapPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Label Content="City: " Style="{StaticResource labelStyleBlack}"/>
                    <ComboBox Name="cityComboBox" Style="{StaticResource comboBoxStyle}" SelectionChanged="OnSelChangedCityCombo" Margin="12,0,0,0"/>
                </WrapPanel>

                <WrapPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Label Content="Region: " Style="{StaticResource labelStyleBlack}"/>
                    <TextBox Name="regionTextBox" Style="{StaticResource textboxStyle}" Margin="12,0,0,0"/>
                </WrapPanel>

                <WrapPanel Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Label Content="Lat: " Style="{StaticResource labelStyleBlack}"/>
                    <TextBox Name="latTextBox" Style="{StaticResource textboxStyle}" Margin="12,0,0,0" PreviewTextInput="NumberValidationTextBox"/>
                </WrapPanel>

                <WrapPanel Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Label Content="Long: " Style="{StaticResource labelStyleBlack}"/>
                    <TextBox Name="longTextBox" Style="{StaticResource textboxStyle}" Margin="12,0,0,0" PreviewTextInput="NumberValidationTextBox"/>
                </WrapPanel>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="2" Name="buttonsGrid" >
            <Button Grid.Column="2" Name="finishButton" Content="Save Changes" Style="{StaticResource buttonStyle}" Click='OnButtonClickSaveChanges'/>
        </Grid>
    </Grid>
</Window>
