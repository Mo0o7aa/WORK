<Page x:Class="ntra_missions.ComplaintsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:ntra_missions"
      mc:Ignorable="d"
      Title="ComplaintsPage">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <local:PageHeader x:Name="pageHeader" Title="Complaints" CurrentTag="Complaints"/>

        <Grid Grid.Row="1" Margin="16,16,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Filters -->
            <Border Style="{StaticResource CardBorder}" VerticalAlignment="Top" Margin="0,44,16,0">
                <StackPanel>
                    <TextBlock Text="Filters" Style="{StaticResource CardTitleText}" Margin="0,0,0,12"/>

                    <CheckBox Name="searchCheckBox" Content="Search site name" Style="{StaticResource checkBoxStyle}" Width="Auto"
                              Checked="OnCheckSearchCheckBox" Unchecked="OnUncheckSearchCheckBox"/>
                    <TextBox Name="searchTextBox" Style="{StaticResource ModernTextBoxBase}" Margin="0,6,0,14" IsEnabled="False"
                             TextChanged="OnTextChangedSearchTextBox" ToolTip="Search site name"/>

                    <CheckBox Name="yearCheckBox" Content="Year" Style="{StaticResource checkBoxStyle}" Width="Auto"
                              Checked="OnCheckYearCheckBox" Unchecked="OnUncheckYearCheckBox"/>
                    <ComboBox Name="yearComboBox" Style="{StaticResource miniComboBoxStyle}" Width="Auto" HorizontalAlignment="Stretch"
                              Margin="0,6,0,14" IsEnabled="False" SelectionChanged="OnSelChangedYearCombo"/>

                    <CheckBox Name="monthCheckBox" Content="Month" Style="{StaticResource checkBoxStyle}" Width="Auto"
                              Checked="OnCheckMonthChheckBox" Unchecked="OnUncheckMonthCheckBox"/>
                    <ComboBox Name="monthComboBox" Style="{StaticResource miniComboBoxStyle}" Width="Auto" HorizontalAlignment="Stretch"
                              Margin="0,6,0,14" IsEnabled="False" SelectionChanged="OnSelChangedMonthCombo"/>

                    <CheckBox Name="companyCheckBox" Content="Company" Style="{StaticResource checkBoxStyle}" Width="Auto"
                              Checked="OnCheckCompanyCheckBox" Unchecked="OnUncheckCompanyCheckBox"/>
                    <ComboBox Name="companyComboBox" Style="{StaticResource miniComboBoxStyle}" Width="Auto" HorizontalAlignment="Stretch"
                              Margin="0,6,0,14" IsEnabled="False" SelectionChanged="OnSelChangedCompanyCombo"/>

                    <CheckBox Name="statusCheckBox" Content="Status" Style="{StaticResource checkBoxStyle}" Width="Auto"
                              Checked="OnCheckStatusCheckBox" Unchecked="OnUncheckStatusCheckBox"/>
                    <ComboBox Name="statusComboBox" Style="{StaticResource miniComboBoxStyle}" Width="Auto" HorizontalAlignment="Stretch"
                              Margin="0,6,0,0" IsEnabled="False" SelectionChanged="OnSelChangedStatusCombo"/>
                </StackPanel>
            </Border>

            <!-- Content -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Complaints: " Style="{StaticResource FieldLabelText}"/>
                    <TextBlock Name="countText" Style="{StaticResource ValueTextBrand}"/>
                </StackPanel>

                <ListBox Grid.Row="1" Name="complaintsList" Style="{StaticResource CardList}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource RowCardBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding ComplaintId}" Style="{StaticResource CardTitleText}"/>
                                            <Border Style="{StaticResource StatusPillBorder}" Background="{Binding StatusBrush}" Margin="14,0,0,0">
                                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusPillText}"/>
                                            </Border>
                                        </StackPanel>

                                        <Grid Margin="0,8,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="300"/>
                                                <ColumnDefinition Width="300"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <TextBlock Text="Company:  " Style="{StaticResource FieldLabelText}"/>
                                                <TextBlock Text="{Binding CompanyName}" Style="{StaticResource ValueTextBrand}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                                                <TextBlock Text="Ticket:  " Style="{StaticResource FieldLabelText}"/>
                                                <TextBlock Text="{Binding Ticket}" Style="{StaticResource ValueText}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2">
                                                <TextBlock Text="Added by:  " Style="{StaticResource FieldLabelText}"/>
                                                <TextBlock Text="{Binding AddedBy}" Style="{StaticResource ValueText}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                                                <TextBlock Text="No of Sites:  " Style="{StaticResource FieldLabelText}"/>
                                                <TextBlock Text="{Binding SitesCount}" Style="{StaticResource ValueText}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,2">
                                                <TextBlock Text="Date:  " Style="{StaticResource FieldLabelText}"/>
                                                <TextBlock Text="{Binding DateText}" Style="{StaticResource ValueText}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                                                <TextBlock Text="Area:  " Style="{StaticResource FieldLabelText}"/>
                                                <TextBlock Text="{Binding Area}" Style="{StaticResource ValueText}"/>
                                            </StackPanel>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,6,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                                        <Image Source="Photos\file_icon.png" Height="20" Width="20" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding FileName}" Style="{StaticResource FileLinkText}"
                                                                   Tag="{Binding FullPath}" MaxWidth="360"
                                                                   ToolTip="Click to open file"
                                                                   PreviewMouseLeftButtonDown="OnClickOpenFile"/>
                                                        <Button Style="{StaticResource RowButton}" Content="✕" Padding="6,1" Margin="8,0,0,0"
                                                                ToolTip="Delete file" Tag="{Binding}"
                                                                Visibility="{Binding DeleteVisibility}"
                                                                Click="OnClickRemoveFile"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                        <Button Style="{StaticResource RowButton}" Content="View" Tag="{Binding}" Click="OnClickViewComplaint"/>
                                        <Button Style="{StaticResource RowButtonFilled}" Content="Edit" Tag="{Binding}" Click="OnClickEditComplaint"
                                                Visibility="{Binding EditVisibility}"/>
                                        <Button Style="{StaticResource RowButton}" Content="Add Mission" Tag="{Binding}" Click="OnClickAddMissionButton"/>
                                        <!-- attaching is open to every user: only editing the
                                             complaint itself stays restricted to its creator -->
                                        <Button Style="{StaticResource RowButton}" Content="Attach File" Tag="{Binding}" Click="OnClickAttachFile"/>
                                        <Button Style="{StaticResource RowButton}" Content="Export Excel" Tag="{Binding}" Click="OnClickExportExcel"/>
                                        <Button Style="{StaticResource RowButton}" Content="Export KML" Tag="{Binding}" Click="OnClickExportMap"/>
                                        <Button Style="{StaticResource RowButtonFilled}" Content="Word Report" Tag="{Binding}" Click="OnClickWordReport"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>

        <!-- Actions -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="0,1,0,0" Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Style="{StaticResource PrimaryButton}" Content="Add" Click="OnBtnClickAdd" Margin="6,0" Visibility="Collapsed"/>
                <Button Style="{StaticResource PrimaryButton}" Content="Import" Click="OnBtnClickImport" Margin="6,0"/>
                <Button Style="{StaticResource SecondaryButton}" Content="Excel Format" Click="OnBtnClickformat" Margin="6,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
