<Window x:Class="ntra_missions.CompanyEquipmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ntra_missions"
        mc:Ignorable="d"
        Title="Equipment" Height="480" Width="720" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="#F2F4F9">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BrandBrush}">
            <Grid Margin="16,0">
                <Image Source="Photos\NTRA_white1.png" VerticalAlignment="Center" Height="52" HorizontalAlignment="Left"/>
                <Label Name="headerLabel" Content="Equipment" Style="{StaticResource headerLabelStyle}"
                       FontSize="24" HorizontalAlignment="Center" Margin="0"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="40,28" VerticalAlignment="Top" Padding="28">
            <Grid Name="mainGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Unit Name" Style="{StaticResource FieldLabelText}" VerticalAlignment="Center" Margin="0,0,0,18"/>
                <TextBox Grid.Column="1" Name="unitNameTextBox" Style="{StaticResource ModernTextBoxBase}" Margin="0,0,0,18"/>

                <TextBlock Grid.Row="1" Text="Unit Type" Style="{StaticResource FieldLabelText}" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="1" Grid.Column="1" Name="unitTypeComboBox" Style="{StaticResource comboBoxStyle}"
                          Width="Auto" HorizontalAlignment="Stretch"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="0,1,0,0" Padding="16,12">
            <Button Name="finishButton" Content="Save Changes" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Center" IsDefault="True" Click="OnButtonClickSaveChanges"/>
        </Border>
    </Grid>
</Window>
