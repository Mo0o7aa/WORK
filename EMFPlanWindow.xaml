<Window x:Class="ntra_missions.EMFPlanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ntra_missions"
        mc:Ignorable="d"
        Title="EMF Plan Window" Height="600" Width="1200" Background="LightGray" WindowState="Maximized">
    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition/>
            <RowDefinition Height="75"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#000080">
            <Image Source="Photos\NTRA_white1.png" VerticalAlignment="Center" Height="200"  HorizontalAlignment="Left"/>
            <Label Name="headerLabel" Content="EMF PLAN" Style="{StaticResource headerLabelStyle}" HorizontalAlignment="Center"/>
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="48">
            <Grid Name="mainGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="60"/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>


                <WrapPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Label Content="Plan Name: " Style="{StaticResource mediumLabelStyleBlack}" />
                    <TextBox Name="planNameTextBox" Style="{StaticResource textboxStyle}"/>
                </WrapPanel>
                <WrapPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Label Content="Assigned Eng. : " Style="{StaticResource mediumLabelStyleBlack}"/>
                    <ComboBox Name="assignedEngineerComboBox" Style="{StaticResource comboBoxStyle}"/>
                </WrapPanel>

                <WrapPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Label Content="Status: " Style="{StaticResource mediumLabelStyleBlack}" />
                    <ComboBox Name="statusComboBox" Style="{StaticResource comboBoxStyle}" IsEnabled="False"/>
                </WrapPanel>
                <WrapPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Label Content="Deadline Date : " Style="{StaticResource mediumLabelStyleBlack}"/>
                    <DatePicker Name="deadlineDatePicker" Style="{StaticResource datePickerStyle}"/>
                </WrapPanel>
                
                <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="24" Background="White">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Row="0" Grid.ColumnSpan="2" Content="EMF Points" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#000080" FontSize="20"  Style="{StaticResource headerLabelStyle}" Margin="0"/>

                    <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Center" Margin="12">
                        <Label Name="searchLabel" Content="Search: " Style="{StaticResource labelStyleBlack}"/>
                        <TextBox Name="searchTextBox" Style="{StaticResource textboxStyle}" Margin="12,0,0,0"/>
                        <Button Name="searchButton" Content="Search" Style="{StaticResource negativeButtonStyle}" Background="White" Margin="12,0,0,0" Click="OnClickSearchButton"/>
                    </WrapPanel>
                    
                    <ScrollViewer Grid.Row="2" Grid.ColumnSpan="4" VerticalScrollBarVisibility="Auto" Margin="24">

                        <Grid Name="emfPointsGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                        </Grid>
                    </ScrollViewer>
                </Grid>

                
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Name="finishButton" Content="Save Changes"  Style="{StaticResource buttonStyle}" FontWeight="DemiBold" Click='OnButtonClickSaveChanges'/>
        </Grid>
    </Grid>
</Window>
