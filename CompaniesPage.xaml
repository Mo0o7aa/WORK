<Page x:Class="ntra_missions.CompaniesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ntra_missions"
      mc:Ignorable="d" 
      Title="CompaniesPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="150"/>
            <RowDefinition Height="100"/>
            <RowDefinition/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#000080">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <WrapPanel>
                <Grid Name="mainMenuGrid" Background="LightGray" VerticalAlignment="Stretch" Width="70" IsHitTestVisible="True" MouseEnter="MouseEnterMainMenu" MouseLeave="MouseLeaveMainMenu" ToolTip="Main Menu" MouseLeftButtonDown="OnClickMainMenu" Cursor="Hand">
                    <Image Name="menuItemImage" Source="Photos\tab_icon.png" Height="50" Width="50"/>
                </Grid>

                <MenuItem Name="tabMenuButton" Visibility="Collapsed">
                    <MenuItem.ContextMenu>
                        <ContextMenu Closed="OnClosedMenuContectMenu">
                            <MenuItem Header="DashBoard" Name="dashboardMenuItem" Click="DashboardMenuSelection"/>
                            <MenuItem Header="Employees" Name="EmployeeMenuItem"  Click="employeeMenuSelection"/>
                            <MenuItem Header="Companies" Name="CompanyMenuItem" IsChecked="True" IsHitTestVisible="False"/>
                            <MenuItem Header="Company Equipment" Name="CompanyEquipmentMenuItem" Click="CompanyEquipmentMenuSelection"/>
                            <MenuItem Header="Sites" Name="sitesMenuItem" Click="SitesMenuSelection"/>
                            <MenuItem Header="EMF" Name="emfMenuItem" Click="emfMenuSelection"/>
                            <MenuItem Header="Complaints" Name="ComplaintsMenuItem" Click="ComplaintsMenuSelection"/>
                            <MenuItem Header="Monitoring Missions" Name="monitoringMenuItem" Click="MonitoringMenuSelection"/>
                            <MenuItem Header="Inspection Missions" Name="inspectionMenuItem" Click="InspectionMenuSelection"/>
                        </ContextMenu>
                    </MenuItem.ContextMenu>
                </MenuItem>

                <Image Source="Photos\NTRA_white1.png" VerticalAlignment="Center" Height="200"  HorizontalAlignment="Left"/>
            </WrapPanel>

            <Grid Name="userNameGrid" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Name="userNameLabel" Foreground="White" FontSize="20" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Content="Username:"/>
                <Button Grid.Row="1" Name="logoutButton" Content="Sign out" Style="{StaticResource buttonStyle}" VerticalAlignment="Bottom" Background="LightGray" FontWeight="Bold" Foreground="#000080" Click="OnClickLogoutButton"/>
            </Grid>

            <Button Grid.Column="1" Name="changePasswordButton" Content="Change Password" VerticalAlignment="Bottom" FontWeight="Bold" Style="{StaticResource negativeButtonStyle}" Width="200" Click="OnClickChangePasswordButton"/>

        </Grid>

        <!--<ScrollViewer Grid.Row="1">
        <WebBrowser  x:Name="wbMaps" Source="https://www.google.com/maps" GotTouchCapture="wbMaps_GotTouchCapture" Navigated="wbMaps_Navigated" Navigating="wbMaps_Navigating"/>
        </ScrollViewer>-->

        <Label Grid.Row="1" Style="{StaticResource headerLabelStyle}" Content="Companies" HorizontalAlignment="Center" Foreground="#000080"/>


        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                <Grid >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="70"/>
                        <RowDefinition Height="70"/>
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Row="0" Grid.Column="0" Name="searchCheckBox" Content="Search &#10;Name" Checked="OnCheckSearchCheckBox" Unchecked="OnUncheckSearchCheckBox" Style="{StaticResource checkBoxStyle}"/>
                    <CheckBox Grid.Row="1" Grid.Column="0" Name="fieldOfWorkCheckBox" Content="Field of &#10;work" Checked="OnCheckFieldCheckBox" Unchecked="OnUncheckFieldCheckBox" Style="{StaticResource checkBoxStyle}"/>
                    <CheckBox Grid.Row="2" Grid.Column="0" Name="bandsCheckBox" Content="Frequency:" Checked="OnCheckBandsCheckBox" Unchecked="OnUncheckBandsCheckBox" Style="{StaticResource checkBoxStyle}"/>


                    <TextBox Grid.Row="0" Grid.Column="1" Name="searchTextBox" TextChanged="OnTextChangedSearchTextBox" Style="{StaticResource miniTextboxStyle}" IsEnabled='False'/>
                    <ComboBox Grid.Row="1" Grid.Column="1" Name="fieldComboBox" SelectionChanged="OnSelChangedFieldCombo" Style="{StaticResource miniComboBoxStyle}" IsEnabled='False'/>
                    
                    <StackPanel Grid.Row="2" Grid.Column="1">
                        <TextBox Margin="12" Name="bandTextBox" Style="{StaticResource miniTextboxStyle}" TextChanged="OnTextChangedBandTextBox" IsEnabled="False" PreviewTextInput="NumberValidationTextBox"/>
                        <ComboBox Margin="12"  Name="bandsComboBox" SelectionChanged="OnSelChangedBandsCombo" Style="{StaticResource miniComboBoxStyle}" IsEnabled='False'/>
                    </StackPanel>

                </Grid>
            </ScrollViewer>

            <Grid Grid.Column="1" Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left">
                    <Border Name="listViewBorder" CornerRadius="0,30,0,0" BorderThickness="3" BorderBrush="#000080" Background="White" Width="150" MouseLeftButtonDown="OnClickListView">
                        <Label Style="{StaticResource mediumLabelStyle}" Content="List View" Foreground="#000080" HorizontalAlignment="Left" FontWeight="Bold"/>
                    </Border>
                    <Border Name="tableViewBorder" CornerRadius="0,30,0,0" BorderThickness="3" BorderBrush="#000080" Background="#000080" Width="150" MouseLeftButtonDown="OnClickTableView">
                        <Label Style="{StaticResource mediumLabelStyle}" Content="Table View" Foreground="White" HorizontalAlignment="Left" FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <ScrollViewer Grid.Row="1" Name="listViewScrollViewer" VerticalContentAlignment="Stretch" >
                    <StackPanel Name="companiesStackPanel" Background="White"/>
                </ScrollViewer>
                <ScrollViewer Grid.Row="1" Name="tableViewScrollViewer"  Visibility="Collapsed" HorizontalScrollBarVisibility="Auto">
                    <Grid Name="companiesGrid" Background="White" ShowGridLines="True"/>

                </ScrollViewer>
            </Grid>
        </Grid>

        <Button Grid.Row="3" Style="{StaticResource buttonStyle}" Content="Add" Click="OnBtnClickAdd"/>
        <Button Grid.Row="3" Style="{StaticResource buttonStyle}" HorizontalAlignment="Right" Content="Add Table" Click="OnBtnClickAdd"/>
    </Grid>
</Page>
    