<Window x:Class="ntra_missions.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ntra_missions"
        mc:Ignorable="d"
        Title="ChangePasswordWindow" Height="450" Width="800" WindowState="Normal" ResizeMode="NoResize" Background="#F2F4F9">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition/>
            <RowDefinition Height="75"/>
        </Grid.RowDefinitions>

        <Grid Background="#000080" Grid.Row="0">
            <Label Content="Change Password" Style="{StaticResource headerLabelStyle}"/>
        </Grid>

        <Grid Grid.Row="1" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <WrapPanel Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Label Content="Old Password: " Style="{StaticResource wideLabelStyle}"/>
                <PasswordBox Style="{StaticResource passworsboxStyle}" Name="oldPasswordBox"/>
                <TextBox Style="{StaticResource textboxStyle}" Name="oldPasswordHiddenTextBox" Visibility="Collapsed"/>
                <Image Source="Photos\show_password_icon.png" Height="30" Width="30" Margin="12,0,0,0" MouseEnter="MouseEnterOldPasswordIcon" MouseLeave="MouseLeaveOldPasswordIcon"/>
            </WrapPanel>

            <WrapPanel Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Label Content="New Password: " Style="{StaticResource wideLabelStyle}"/>
                <PasswordBox Style="{StaticResource passworsboxStyle}" Name="newPasswordTextBox"/>
                <TextBox Style="{StaticResource textboxStyle}" Name="newPasswordHiddenBox" Visibility="Collapsed"/>
                <Image Source="Photos\show_password_icon.png" Height="30" Width="30" Margin="12,0,0,0" MouseEnter="MouseEnterNewPasswordIcon" MouseLeave="MouseLeaveNewPasswordIcon"/>
            </WrapPanel>

            <WrapPanel Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Label Content="Confirm Password: " Style="{StaticResource wideLabelStyle}"/>
                <PasswordBox Style="{StaticResource passworsboxStyle}" Name="confirmPasswordTextBox"/>
                <TextBox Style="{StaticResource textboxStyle}" Name="confirmPasswordHiddenBox" Visibility="Collapsed"/>
                <Image Source="Photos\show_password_icon.png" Height="30" Width="30" Margin="12,0,0,0" MouseEnter="MouseEnterConfirmPasswordIcon" MouseLeave="MouseLeaveConfirmPasswordIcon"/>
            </WrapPanel>



        </Grid>

        <Button Grid.Row="2" Style="{StaticResource buttonStyle}" Width="150" Height="50" Content="Save Changes" Click="OnClickSaveChangesButton"/>


    </Grid>
</Window>
