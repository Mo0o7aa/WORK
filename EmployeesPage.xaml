<Page x:Class="ntra_missions.EmployeesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:ntra_missions"
      mc:Ignorable="d"
      Title="EmployeesPage">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <local:PageHeader x:Name="pageHeader" Title="User Profile" CurrentTag="Employees"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="24,16" MaxWidth="1100">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,12">
                    <Label Name="mainLabel" Style="{StaticResource headerLabelStyle}" Content="User Profile" Margin="0" Foreground="{StaticResource BrandBrush}"/>

                    <StackPanel Name="employeeSelectionStackPanel" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Orientation="Horizontal" Visibility="Collapsed">
                        <Label Name="employeeLabel" Content="Employee" Style="{StaticResource labelStyle}"/>
                        <ComboBox Name="employeeCombo" Style="{StaticResource comboBoxStyle}" SelectionChanged="OnSelChangedEmployeeComboBox"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="28">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Image Grid.RowSpan="4" Source="Photos\avatar_icon.png" Height="220" Width="160"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,24,0"/>

                        <StackPanel Grid.Column="1" Margin="0,0,24,18">
                            <TextBlock Text="Name" Style="{StaticResource FieldLabelText}" Margin="0,0,0,4"/>
                            <TextBox Name="employeeNameTextBox" Style="{StaticResource ModernTextBoxBase}" IsReadOnly="True"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="0,0,0,18">
                            <TextBlock Text="Department" Style="{StaticResource FieldLabelText}" Margin="0,0,0,4"/>
                            <ComboBox Name="employeeDepartmentComboBox" Style="{StaticResource comboBoxStyle}" Width="Auto"
                                      HorizontalAlignment="Stretch" IsEnabled="False"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,24,18">
                            <TextBlock Text="Title" Style="{StaticResource FieldLabelText}" Margin="0,0,0,4"/>
                            <ComboBox Name="employeeTitleComboBox" Style="{StaticResource comboBoxStyle}" Width="Auto"
                                      HorizontalAlignment="Stretch" IsEnabled="False"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,18">
                            <TextBlock Text="Email" Style="{StaticResource FieldLabelText}" Margin="0,0,0,4"/>
                            <TextBox Name="employeeEmailTextBox" Style="{StaticResource ModernTextBoxBase}" IsReadOnly="True"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,24,18">
                            <TextBlock Text="Position" Style="{StaticResource FieldLabelText}" Margin="0,0,0,4"/>
                            <ComboBox Name="employeePositionComboBox" Style="{StaticResource comboBoxStyle}" Width="Auto"
                                      HorizontalAlignment="Stretch" IsEnabled="False"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2">
                            <TextBlock Text="Telephone" Style="{StaticResource FieldLabelText}" Margin="0,0,0,4"/>
                            <WrapPanel Name="telephoneWrapPanel">
                                <TextBox Name="employeePhoneTextBox" Style="{StaticResource textboxStyle}" IsReadOnly="True" Width="250"
                                         HorizontalAlignment="Left" PreviewTextInput="NumberValidationTextBox"/>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="0,1,0,0" Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Name="addTelephoneButton" Style="{StaticResource SecondaryButton}" Content="Add Phone"
                        Click="OnBtnClickAddTelephone" IsEnabled="False" Margin="6,0"/>
                <Button Name="removeTelephoneButton" Style="{StaticResource SecondaryButton}" Content="Remove"
                        Click="OnBtnClickRemoveTelephone" IsEnabled="False" Margin="6,0"/>
                <Button Name="editButton" Style="{StaticResource PrimaryButton}" Content="Edit Info"
                        Click="OnBtnClickEdit" Margin="6,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
