<Page x:Class="ntra_missions.EmployeesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ntra_missions"
      mc:Ignorable="d" 
      Title="EmployeesPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="150"/>
            <RowDefinition Height="100"/>
            <RowDefinition/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#000080">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <WrapPanel>
                <Grid Name="mainMenuGrid" Background="LightGray" VerticalAlignment="Stretch" Width="70" IsHitTestVisible="True" MouseEnter="MouseEnterMainMenu" MouseLeave="MouseLeaveMainMenu" ToolTip="Main Menu" MouseLeftButtonDown="OnClickMainMenu" Cursor="Hand">
                    <Image Name="menuItemImage" Source="Photos\tab_icon.png" Height="50" Width="50"/>
                </Grid>

                <MenuItem Name="tabMenuButton" Visibility="Collapsed">
                    <MenuItem.ContextMenu>
                        <ContextMenu >
                            <MenuItem Header="DashBoard" Name="dashboardMenuItem" Click="DashboardMenuSelection"/>
                            <MenuItem Header="Employees" Name="EmployeeMenuItem"  IsChecked="True" IsHitTestVisible="False"/>
                            <MenuItem Header="Companies" Name="CompanyMenuItem" Click="CompanyMenuSelection"/>
                            <MenuItem Header="Company Equipment" Name="CompanyEquipmentMenuItem" Click="CompanyEquipmentMenuSelection"/>
                            <MenuItem Header="Sites" Name="sitesMenuItem" Click="SitesMenuSelection"/>
                            <MenuItem Header="EMF" Name="emfMenuItem" Click="emfMenuSelection"/>
                            <MenuItem Header="Complaints" Name="ComplaintsMenuItem" Click="ComplaintsMenuSelection"/>
                            <MenuItem Header="Monitoring Missions" Name="monitoringMenuItem" Click="MonitoringMissionsMenuSelection"/>
                            <MenuItem Header="Inspection Missions" Name="inspectionMenuItem" Click="InspectionMenuSelection"/>
                        </ContextMenu>
                    </MenuItem.ContextMenu>
                </MenuItem>

                <Image Source="Photos\NTRA_white1.png" VerticalAlignment="Center" Height="200"  HorizontalAlignment="Left"/>
            </WrapPanel>

            <Grid Name="userNameGrid" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Name="userNameLabel" Foreground="White" FontSize="20" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Content="Username:"/>
                <Button Grid.Row="1" Name="logoutButton" Content="Sign out" Style="{StaticResource buttonStyle}" VerticalAlignment="Bottom" Background="LightGray" FontWeight="Bold" Foreground="#000080" Click="OnClickLogoutButton"/>
            </Grid>

            <Button Grid.Column="1" Name="changePasswordButton" Content="Change Password" VerticalAlignment="Bottom" FontWeight="Bold" Style="{StaticResource negativeButtonStyle}" Width="200" Click="OnClickChangePasswordButton"/>

        </Grid>

        <!--<ScrollViewer Grid.Row="1">
        <WebBrowser  x:Name="wbMaps" Source="https://www.google.com/maps" GotTouchCapture="wbMaps_GotTouchCapture" Navigated="wbMaps_Navigated" Navigating="wbMaps_Navigating"/>
        </ScrollViewer>-->

        <Label Grid.Row="1" Style="{StaticResource headerLabelStyle}" Name="mainLabel" Content="User Profile" HorizontalAlignment="Center" Foreground="#000080"/>
        <StackPanel Grid.Row="1" Margin="12" HorizontalAlignment="Right" VerticalAlignment="Center" Name="employeeSelectionStackPanel" Visibility="Collapsed">
            <Label Style="{StaticResource labelStyle}" Name="employeeLabel" Content="Employee" HorizontalAlignment="Center" />
            <ComboBox Style="{StaticResource comboBoxStyle}" Name="employeeCombo" SelectionChanged="OnSelChangedEmployeeComboBox"/>
        </StackPanel>




        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="100"/>
                <RowDefinition Height="100"/>
                <RowDefinition Height="100"/>
                <RowDefinition Height="100"/>
            </Grid.RowDefinitions>

            <WrapPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                <Label Content="Name: " Style="{StaticResource mediumLabelStyleBlack}"/>
                <TextBox Name="employeeNameTextBox" Style="{StaticResource textboxStyle}" IsReadOnly="True" Width="250" FontWeight="Bold" Foreground="#000080"/>
            </WrapPanel>

            <WrapPanel  Grid.Row="0" Grid.Column="2" VerticalAlignment="Center">
                <Label Content="Department: " Style="{StaticResource mediumLabelStyleBlack}"/>
                <ComboBox Name="employeeDepartmentComboBox" Style="{StaticResource comboBoxStyle}" IsEnabled="False" Width="250"/>
            </WrapPanel>

            <WrapPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">
                <Label Content="Title: " Style="{StaticResource mediumLabelStyleBlack}"/>
                <ComboBox Name="employeeTitleComboBox" Style="{StaticResource comboBoxStyle}" IsEnabled="False" Width="250"/>
            </WrapPanel>

            <WrapPanel Grid.Row="1" Grid.Column="2" VerticalAlignment="Center">
                <Label Content="Email: " Style="{StaticResource mediumLabelStyleBlack}"/>
                <TextBox Name="employeeEmailTextBox" Style="{StaticResource textboxStyle}" IsReadOnly="True" Width="250" FontWeight="Bold" Foreground="#000080"/>
            </WrapPanel>

            <WrapPanel Grid.Row="2" Grid.Column="1" VerticalAlignment="Center">
                <Label Content="Position: " Style="{StaticResource mediumLabelStyleBlack}"/>
                <ComboBox Name="employeePositionComboBox" Style="{StaticResource comboBoxStyle}" IsEnabled="False" Width="250"/>
            </WrapPanel>

            <WrapPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Name="telephoneWrapPanel"  VerticalAlignment="Center">
                <Label Content="Telephone: " Style="{StaticResource mediumLabelStyleBlack}"/>
                <TextBox Name="employeePhoneTextBox" Style="{StaticResource textboxStyle}" IsReadOnly="True" Width="250" PreviewTextInput="NumberValidationTextBox" FontWeight="Bold" Foreground="#000080"/>
            </WrapPanel>

            <Image Grid.Column="0" Grid.RowSpan="4" Source="Photos\avatar_icon.png" HorizontalAlignment="Center" VerticalAlignment="Center" Height="300" Width="200"/>

        </Grid>

        <Grid Grid.Row="3" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            
            <Button Grid.Column="0" Style="{StaticResource buttonStyle}" Name="addTelephoneButton" Content="Add Phone" Click="OnBtnClickAddTelephone" IsEnabled="False"/>
            <Button Grid.Column="1" Style="{StaticResource buttonStyle}" Name="removeTelephoneButton" Content="Remove" Click="OnBtnClickRemoveTelephone" IsEnabled="False"/>
            <Button Grid.Column="2"  Style="{StaticResource buttonStyle}" Name="editButton" Content="Edit Info" Click="OnBtnClickEdit"/>

        </Grid>

    </Grid>
</Page>
