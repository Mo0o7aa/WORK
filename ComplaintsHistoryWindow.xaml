<Window x:Class="ntra_missions.ComplaintsHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ntra_missions"
        mc:Ignorable="d"
        Title="ComplaintsHistoryWindow" Height="450" Width="800" Background="#F2F4F9" WindowState="Maximized">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition/>
            <RowDefinition Height="75"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#000080">
            <Image Source="Photos\NTRA_white1.png" VerticalAlignment="Center" Height="70"  HorizontalAlignment="Left" Margin="16,0,0,0"/>
            <Label Name="headerLabel" Content="Site History" Style="{StaticResource headerLabelStyle}" HorizontalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="80"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0" Grid.Row="0" Content="Complaints" Style="{StaticResource headerLabelStyle}" HorizontalAlignment="Center" Foreground="#000080"/>
            <Label Grid.Column="1" Grid.Row="0" Content="Missions" Style="{StaticResource headerLabelStyle}" HorizontalAlignment="Center" Foreground="#000080"/>

            <ScrollViewer Grid.Column="0" Grid.Row="1" Margin="12">
                <StackPanel Name="complaintsStackPanel" Orientation="Vertical" />
            </ScrollViewer>

            <ScrollViewer Grid.Column="1" Grid.Row="1" Margin="12">
                <StackPanel Name="missionsStackPanel" Orientation="Vertical" />
            </ScrollViewer>

        </Grid>

        <Grid Grid.Row="2" Name="buttonsGrid" Margin="24,0,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
        </Grid>
    </Grid>
</Window>
